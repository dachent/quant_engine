#!/bin/sh
# Workstation defense-in-depth only; see GOV-002 and ADR 0001.
# Git does not enforce protected main for this private Free repository.
repo_root="$(git rev-parse --show-toplevel)" || exit 2
if [ -x "$repo_root/.venv/Scripts/python.exe" ]; then
  project_python="$repo_root/.venv/Scripts/python.exe"
elif [ -x "$repo_root/.venv/bin/python" ]; then
  project_python="$repo_root/.venv/bin/python"
else
  echo "QE_PUSH_RUNTIME_UNAVAILABLE" >&2
  exit 2
fi
exec "$project_python" "$repo_root/tools/check_push_policy.py"
