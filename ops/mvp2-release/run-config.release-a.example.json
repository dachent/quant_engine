{
  "_comment": "Release A run configuration template (value-free). Every <...> is an operator-supplied absolute path or pin; the only literals are the stated cutoff and the gate settings. G0 (tools/release_preflight.py g0 --config run.json) reads the keys listed in release_preflight.CONFIG_KEYS.",
  "ceremony": "full",
  "mode": "release",
  "repo_root": "<absolute path of the frozen clone>",
  "python": "<absolute path of the 3.11 interpreter>",
  "cycle": "<absolute scratch cycle directory>",
  "run": "<absolute attended run output root>",
  "code_commit": "<40-hex frozen repository sha>",
  "release_label": "A",
  "requested_as_of": "2026-11-06",
  "release_cutoffs": {
    "A": "2026-11-06",
    "B": "<cutoff of release B, stated by the owner>"
  },
  "free_space_floor_gb": 60,
  "scratch_roots": ["<absolute scratch root>"],
  "coordination_root": "<absolute coordination root>",
  "authority_roots": {"<root id>": "<absolute root directory>"},
  "source_workspace": "<absolute real workspace>",
  "artifact_inputs": [],
  "replica_relative_ok": [],
  "pinned_files": {},
  "evidence_dest": "<absolute evidence destination outside the cycle>",
  "release_inputs_root": "<absolute pinned release-inputs root>",
  "release_inputs_manifest_sha256": "<64-hex pin>",
  "gate_receipt_max_age_hours": 24
}
