{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-engine.local/schemas/core/release-journal.schema.json",
  "title": "quant_engine coordinated release journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applied_companions", "applied_targets", "last_error", "release_id", "state"
  ],
  "properties": {
    "release_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {
      "enum": [
        "PREPARED", "COMMITTING", "COMMITTED", "ROLLING_BACK",
        "ROLLED_BACK", "RECOVERY_FAILED"
      ]
    },
    "applied_targets": {"type": "array", "items": {"type": "string"}},
    "applied_companions": {"type": "array", "items": {"type": "string"}},
    "last_error": {"type": ["string", "null"]}
  }
}
