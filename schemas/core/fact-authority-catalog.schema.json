{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-engine.local/schemas/core/fact-authority-catalog.schema.json",
  "title": "quant_engine fact authority catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["authority_catalog_schema_version", "freshness_policies", "rules"],
  "properties": {
    "authority_catalog_schema_version": {"const": 1},
    "freshness_policies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/freshnessPolicy"}
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/authorityRule"}
    }
  },
  "$defs": {
    "portableId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "factKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_type", "provider_id", "subject_id", "subject_type"],
      "properties": {
        "fact_type": {"$ref": "#/$defs/portableId"},
        "provider_id": {"$ref": "#/$defs/portableId"},
        "subject_id": {"$ref": "#/$defs/portableId"},
        "subject_type": {
          "enum": ["ACCOUNT", "CAPITAL_POOL", "DATASET", "MARKET", "PORTFOLIO", "STRATEGY"]
        }
      }
    },
    "freshnessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_interval_days", "grace_days", "mode", "policy_id", "stale_after_days"],
      "properties": {
        "expected_interval_days": {"type": ["integer", "null"], "minimum": 1},
        "grace_days": {"type": "integer", "minimum": 0},
        "mode": {"enum": ["RECURRING", "FINITE"]},
        "policy_id": {"$ref": "#/$defs/portableId"},
        "stale_after_days": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "authorityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_non_current", "allow_partial", "allowed_gap_codes", "authority_id",
        "consumer_id", "effective_end", "effective_start", "evidence_layers",
        "finalization_state", "freshness_policy_id", "key"
      ],
      "properties": {
        "allow_non_current": {"type": "boolean"},
        "allow_partial": {"type": "boolean"},
        "allowed_gap_codes": {"type": "array", "items": {"$ref": "#/$defs/portableId"}, "uniqueItems": true},
        "authority_id": {"$ref": "#/$defs/portableId"},
        "consumer_id": {"$ref": "#/$defs/portableId"},
        "effective_end": {"type": ["string", "null"], "format": "date"},
        "effective_start": {"type": "string", "format": "date"},
        "evidence_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["ACCOUNT_LIVE", "PROVIDER_LIVE", "OFFICIAL_VEHICLE", "PREDECESSOR", "SHADOW_OOS", "BACKTEST", "STATIC_HISTORY", "CONCEPTUAL_STRESS"]
          }
        },
        "finalization_state": {"enum": ["PROVISIONAL", "FINAL"]},
        "freshness_policy_id": {"$ref": "#/$defs/portableId"},
        "key": {"$ref": "#/$defs/factKey"}
      }
    }
  }
}
