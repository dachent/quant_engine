{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-engine.local/schemas/core/generation-receipt.schema.json",
  "title": "quant_engine detached generation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_schema_version",
    "final_path_count",
    "generation_id",
    "independent_report",
    "inventory",
    "manifest"
  ],
  "properties": {
    "envelope_schema_version": {"const": 1},
    "final_path_count": {"type": "integer", "minimum": 4},
    "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "independent_report": {"$ref": "#/$defs/source_artifact"},
    "inventory": {"$ref": "#/$defs/inventory"},
    "manifest": {"$ref": "#/$defs/manifest"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "as_of_date", "schema", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": {"const": "verification/independent-verification.json"},
        "as_of_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"$ref": "#/$defs/size_bytes"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "size_bytes"],
      "properties": {
        "relative_path": {"const": "generation-inventory.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"$ref": "#/$defs/size_bytes"}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "size_bytes"],
      "properties": {
        "relative_path": {"const": "generation.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"$ref": "#/$defs/size_bytes"}
      }
    }
  }
}
