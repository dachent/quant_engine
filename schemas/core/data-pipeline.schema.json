{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-engine.local/schemas/core/data-pipeline.schema.json",
  "title": "quant_engine explicit-ID rollforward pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "as_of_date", "code_commit", "companions", "coordination_root",
    "created_at", "gates", "nodes", "pipeline_id", "roots",
    "schema_version", "state_root"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "pipeline_id": {"$ref": "#/$defs/id"},
    "as_of_date": {"type": "string", "format": "date"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "coordination_root": {"$ref": "#/$defs/path"},
    "state_root": {"$ref": "#/$defs/path"},
    "roots": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/path"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/artifactNode"},
          {"$ref": "#/$defs/generationNode"},
          {"$ref": "#/$defs/commandNode"}
        ]
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "companions": {
      "type": "array",
      "items": {"$ref": "#/$defs/companion"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1},
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "size_bytes"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "artifactNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depends_on", "kind", "node_id", "path", "sha256", "size_bytes"
      ],
      "properties": {
        "depends_on": {"$ref": "#/$defs/dependencies"},
        "kind": {"const": "ARTIFACT"},
        "node_id": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "generationNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depends_on", "files", "generation_id", "kind", "manifest_sha256",
        "node_id", "release_target", "root_id", "source_dir"
      ],
      "properties": {
        "depends_on": {"$ref": "#/$defs/dependencies"},
        "files": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}
        },
        "generation_id": {"$ref": "#/$defs/sha256"},
        "kind": {"const": "GENERATION"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "node_id": {"$ref": "#/$defs/id"},
        "release_target": {"type": "boolean"},
        "root_id": {"$ref": "#/$defs/id"},
        "source_dir": {"oneOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]}
      }
    },
    "commandNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv", "cwd", "declared_reads", "declared_writes", "depends_on",
        "effect", "kind", "node_id", "request_identity", "retry_limit",
        "timeout_seconds"
      ],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"$ref": "#/$defs/path"},
        "declared_reads": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "declared_writes": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "depends_on": {"$ref": "#/$defs/dependencies"},
        "effect": {"enum": ["LOCAL_ONLY", "READ_ONLY_EXTERNAL"]},
        "kind": {"const": "COMMAND"},
        "node_id": {"$ref": "#/$defs/id"},
        "request_identity": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "retry_limit": {"type": "integer", "minimum": 0, "maximum": 2},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "path", "sha256"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "companion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["companion_id", "relative_path", "root_id", "sha256", "source_path"],
      "properties": {
        "companion_id": {"$ref": "#/$defs/id"},
        "relative_path": {"type": "string", "minLength": 1},
        "root_id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_path": {"$ref": "#/$defs/path"}
      }
    }
  }
}
