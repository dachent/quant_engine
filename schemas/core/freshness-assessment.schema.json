{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-engine.local/schemas/core/freshness-assessment.schema.json",
  "title": "Consumer freshness health bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_schema_version", "as_of_date", "evaluated_on", "assessments",
    "policies", "provider_ledger"
  ],
  "properties": {
    "assessment_schema_version": {"const": 4},
    "as_of_date": {"type": "string", "format": "date"},
    "evaluated_on": {"type": "string", "format": "date"},
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "calendar", "expected_interval_days", "grace_days", "mode",
          "policy_id", "stale_after_days"
        ],
        "properties": {
          "calendar": {"enum": ["CALENDAR_DAY", "WEEKDAY_SESSION"]},
          "expected_interval_days": {"type": ["integer", "null"], "minimum": 1},
          "grace_days": {"type": "integer", "minimum": 0},
          "mode": {"enum": ["FINITE", "RECURRING"]},
          "policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "stale_after_days": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    },
    "provider_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of_date", "catalog_sha256", "catalog_size_bytes", "generation_id",
        "manifest_sha256", "manifest_size_bytes"
      ],
      "properties": {
        "as_of_date": {"type": "string", "format": "date"},
        "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "catalog_size_bytes": {"type": "integer", "minimum": 1},
        "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "acquired_at", "blocks_current_consumers", "coverage_status",
          "escalation_required", "evaluated_on", "fact_type",
          "last_accepted_date", "lane", "next_expected_date", "policy_id",
          "provider_id", "reason", "required_for_current", "revision_state",
          "state", "subject_id", "subject_type"
        ],
        "properties": {
          "acquired_at": {"type": ["string", "null"], "format": "date-time"},
          "blocks_current_consumers": {"type": "boolean"},
          "coverage_status": {"type": "string", "minLength": 1},
          "escalation_required": {"type": "boolean"},
          "evaluated_on": {"type": "string", "format": "date"},
          "fact_type": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "last_accepted_date": {"type": ["string", "null"], "format": "date"},
          "lane": {"enum": ["ACCOUNT", "PROVIDER", "PROVIDER_CAPTURE"]},
          "next_expected_date": {"type": ["string", "null"], "format": "date"},
          "policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "provider_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "required_for_current": {"type": "boolean"},
          "revision_state": {"enum": ["ORIGINAL", "REVISED"]},
          "state": {"enum": ["FRESH", "LATE", "STALE", "FINITE_COMPLETE", "UNAVAILABLE"]},
          "subject_id": {"type": "string", "minLength": 1},
          "subject_type": {"enum": ["DATASET", "STRATEGY"]}
        }
      }
    }
  }
}
