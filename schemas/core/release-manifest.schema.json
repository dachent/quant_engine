{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-engine.local/schemas/core/release-manifest.schema.json",
  "title": "quant_engine coordinated release manifest",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"},
    {"$ref": "#/$defs/v3"}
  ],
  "$defs": {
    "gate": {"type": "object", "additionalProperties": false, "required": ["evidence_sha256", "gate_id"], "properties": {"gate_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "pointer": {"type": ["object", "null"]},
    "companion-v1-v2": {"type": "object", "additionalProperties": false, "required": ["companion_id", "previous_sha256", "proposed_sha256", "relative_path", "root_id"], "properties": {"companion_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "root_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "relative_path": {"type": "string", "minLength": 1}, "proposed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "previous_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}},
    "companion-v3": {"type": "object", "additionalProperties": false, "required": ["companion_id", "parent_identity", "previous_sha256", "proposed_sha256", "relative_path", "root_id"], "properties": {"companion_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "root_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "relative_path": {"type": "string", "minLength": 1}, "proposed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "previous_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "parent_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "target-v1": {"type": "object", "additionalProperties": false, "required": ["previous_pointer", "proposed_generation_id", "proposed_manifest_sha256", "root_id"], "properties": {"root_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "proposed_generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "proposed_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "previous_pointer": {"$ref": "#/$defs/pointer"}}},
    "target-v2": {"type": "object", "additionalProperties": false, "required": ["previous_pointer", "proposed_generation_id", "proposed_inventory_sha256", "proposed_manifest_sha256", "root_id"], "properties": {"root_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "proposed_generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "proposed_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "proposed_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "previous_pointer": {"$ref": "#/$defs/pointer"}}},
    "target-v3": {"type": "object", "additionalProperties": false, "required": ["previous_inventory_sha256", "previous_pointer", "proposed_generation_id", "proposed_inventory_sha256", "proposed_manifest_sha256", "root_id", "root_identity"], "properties": {"root_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "root_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "proposed_generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "proposed_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "proposed_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "previous_pointer": {"$ref": "#/$defs/pointer"}, "previous_inventory_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}},
    "v1": {"type": "object", "additionalProperties": false, "required": ["code_commit", "companions", "created_at", "gates", "release_id", "release_schema_version", "targets"], "properties": {"release_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "created_at": {"type": "string", "format": "date-time"}, "release_schema_version": {"const": 1}, "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}}, "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target-v1"}}, "companions": {"type": "array", "items": {"$ref": "#/$defs/companion-v1-v2"}}}},
    "v2": {"type": "object", "additionalProperties": false, "required": ["code_commit", "companions", "created_at", "gates", "previous_authority", "release_id", "release_schema_version", "targets"], "properties": {"release_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "created_at": {"type": "string", "format": "date-time"}, "release_schema_version": {"const": 2}, "previous_authority": {"oneOf": [{"type": "null"}, {"$ref": "release-authority.schema.json"}]}, "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}}, "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target-v2"}}, "companions": {"type": "array", "items": {"$ref": "#/$defs/companion-v1-v2"}}}},
    "v3": {"type": "object", "additionalProperties": false, "required": ["code_commit", "companions", "created_at", "gates", "previous_authority", "release_id", "release_schema_version", "targets"], "properties": {"release_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "created_at": {"type": "string", "format": "date-time"}, "release_schema_version": {"const": 3}, "previous_authority": {"oneOf": [{"type": "null"}, {"$ref": "release-authority.schema.json"}]}, "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}}, "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target-v3"}}, "companions": {"type": "array", "items": {"$ref": "#/$defs/companion-v3"}}}}
  }
}
