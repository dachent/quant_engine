{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-engine.local/schemas/core/release-manifest.schema.json",
  "title": "quant_engine coordinated release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code_commit", "companions", "created_at", "gates", "release_id",
    "release_schema_version", "targets"
  ],
  "properties": {
    "release_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "release_schema_version": {"const": 1},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_sha256", "gate_id"],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "previous_pointer", "proposed_generation_id",
          "proposed_manifest_sha256", "root_id"
        ],
        "properties": {
          "root_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "proposed_generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "proposed_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "previous_pointer": {"type": ["object", "null"]}
        }
      }
    },
    "companions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "companion_id", "previous_sha256", "proposed_sha256",
          "relative_path", "root_id"
        ],
        "properties": {
          "companion_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "root_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "relative_path": {"type": "string", "minLength": 1},
          "proposed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "previous_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
