{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-engine.local/schemas/core/current-pointer.schema.json",
  "title": "quant_engine generation authority pointer",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id", "manifest_sha256", "pointer_schema_version", "state"
      ],
      "properties": {
        "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pointer_schema_version": {"const": 1},
        "state": {"const": "PUBLISHED"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_inventory_sha256", "generation_id", "manifest_sha256",
        "pointer_schema_version", "state"
      ],
      "properties": {
        "artifact_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pointer_schema_version": {"const": 2},
        "state": {"const": "PUBLISHED"}
      }
    }
  ]
}
