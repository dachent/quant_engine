{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dachent/quant_engine/schemas/portfolio/baseline-catalog.schema.json",
  "title": "Private portfolio baseline catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline_schema_version",
    "policy_version",
    "as_of_date",
    "provenance",
    "source_artifacts",
    "accounts",
    "capital_pools",
    "strategies",
    "strategy_version_catalog",
    "assignments",
    "allocations",
    "current_capital",
    "audit_snapshot",
    "securities",
    "positions",
    "provider_admissions",
    "provider_coverage",
    "provider_strategy_returns",
    "transactions",
    "flows",
    "nav_observations",
    "calendar_coverage",
    "strategy_nav_coverage",
    "costs",
    "evidence_links",
    "evidence_layer_metrics",
    "strategy_live_metrics",
    "strategy_provider_evidence",
    "strategy_returns",
    "implementation_gaps",
    "corrections",
    "assumptions",
    "unmapped_records",
    "fact_coverage",
    "reconciliation_checks",
    "reconciliation_exceptions",
    "replay"
  ],
  "properties": {
    "baseline_schema_version": {"const": 1},
    "policy_version": {"const": "PORT-PERF-1"},
    "as_of_date": {"type": "string", "format": "date"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_id", "catalog_sha256"],
      "properties": {
        "generation_id": {"$ref": "#/$defs/sha256"},
        "catalog_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_artifacts": {"type": "array", "minItems": 17, "items": {"type": "object"}},
    "accounts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/account"}},
    "capital_pools": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "strategies": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "object"}},
    "strategy_version_catalog": {"$ref": "strategy-version-catalog.schema.json"},
    "assignments": {"type": "array", "items": {"type": "object"}},
    "allocations": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object"}},
    "current_capital": {"$ref": "#/$defs/current_capital"},
    "audit_snapshot": {"$ref": "#/$defs/audit_snapshot"},
    "securities": {"type": "array", "items": {"type": "object"}},
    "positions": {"type": "array", "items": {"type": "object"}},
    "provider_admissions": {"type": "array", "items": {"type": "object"}},
    "provider_coverage": {"type": "array", "items": {"type": "object"}},
    "provider_strategy_returns": {"type": "array", "items": {"type": "object"}},
    "transactions": {"type": "array", "items": {"type": "object"}},
    "flows": {"type": "array", "items": {"type": "object"}},
    "nav_observations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "calendar_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/calendar_status"}},
    "strategy_nav_coverage": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "object"}},
    "costs": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "object"}},
    "evidence_links": {"type": "array", "minItems": 9, "items": {"type": "object"}},
    "evidence_layer_metrics": {"type": "array", "items": {"type": "object"}},
    "strategy_live_metrics": {"type": "array", "items": {"type": "object"}},
    "strategy_provider_evidence": {"type": "array", "items": {"type": "object"}},
    "strategy_returns": {"type": "array", "items": {"type": "object"}},
    "implementation_gaps": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "object"}},
    "corrections": {"type": "array", "items": {"type": "object"}},
    "assumptions": {"type": "array", "items": {"type": "object"}},
    "unmapped_records": {"type": "array", "items": {"type": "object"}},
    "fact_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverage"}},
    "fact_coverage_matrix": {"type": "array", "items": {"$ref": "#/$defs/fact_coverage_detail"}},
    "observation_windows": {"type": "array", "items": {"type": "object"}},
    "attribution_dispositions": {"type": "array", "items": {"type": "object"}},
    "hwm_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "anchor",
        "calendar_authorities",
        "periods",
        "reconciliation"
      ],
      "properties": {
        "contract_version": {"const": 1},
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anchor_date",
            "index_base_value",
            "hwm_policy_id",
            "acceptance_provenance"
          ],
          "properties": {
            "anchor_date": {"type": "string", "format": "date"},
            "index_base_value": {"const": "1.0"},
            "hwm_policy_id": {"const": "PORT-HWM-3"},
            "acceptance_provenance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "accepted_at",
                "accepted_by",
                "source_artifact_id",
                "source_artifact_sha256"
              ],
              "properties": {
                "accepted_at": {"type": "string", "format": "date-time"},
                "accepted_by": {"type": "string", "minLength": 1},
                "source_artifact_id": {"type": "string", "minLength": 1},
                "source_artifact_sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        },
        "calendar_authorities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lane",
              "authority_id",
              "authority_version",
              "calendar_kind",
              "admitted_source_artifact_id"
            ],
            "properties": {
              "lane": {"enum": ["ACCOUNT", "PROVIDER", "LEGACY"]},
              "authority_id": {"type": "string", "minLength": 1},
              "authority_version": {"type": "string", "minLength": 1},
              "calendar_kind": {
                "enum": ["EXCHANGE", "ALWAYS_ON", "PROVIDER_PUBLICATION"]
              },
              "admitted_source_artifact_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "periods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strategy_id",
              "date",
              "lane",
              "disposition",
              "beginning_capital_usd",
              "return_source_record_id",
              "flow_status",
              "fx_status"
            ],
            "properties": {
              "strategy_id": {"type": "string", "minLength": 1},
              "date": {"type": "string", "format": "date"},
              "lane": {"enum": ["ACCOUNT", "PROVIDER", "LEGACY"]},
              "disposition": {
                "enum": [
                  "AVAILABLE",
                  "UNAVAILABLE",
                  "NOT_ADMITTED",
                  "EXPECTED_NON_TRADING",
                  "EXCLUDED_BY_POLICY"
                ]
              },
              "beginning_capital_usd": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "null"}
                ]
              },
              "return_source_record_id": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "null"}
                ]
              },
              "component_account_ids": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  {"type": "null"}
                ]
              },
              "flow_status": {
                "enum": [
                  "OBSERVED",
                  "CONFIRMED_ZERO",
                  "MISSING"
                ]
              },
              "fx_status": {
                "enum": [
                  "OBSERVED",
                  "CONFIRMED_ONE",
                  "NOT_REQUIRED",
                  "MISSING"
                ]
              },
              "flow_source_record_ids": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "fx_source_record_ids": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "disposition": {"const": "AVAILABLE"}
                  },
                  "required": ["disposition"]
                },
                "then": {
                  "properties": {
                    "beginning_capital_usd": {"type": "string", "minLength": 1},
                    "return_source_record_id": {"type": "string", "minLength": 1}
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "disposition": {
                      "enum": [
                        "UNAVAILABLE",
                        "NOT_ADMITTED",
                        "EXPECTED_NON_TRADING",
                        "EXCLUDED_BY_POLICY"
                      ]
                    }
                  },
                  "required": ["disposition"]
                },
                "then": {
                  "properties": {
                    "beginning_capital_usd": {"type": "null"},
                    "return_source_record_id": {"type": "null"}
                  }
                }
              },
              {
                "if": {
                  "properties": {"flow_status": {"const": "CONFIRMED_ZERO"}},
                  "required": ["flow_status"]
                },
                "then": {
                  "properties": {
                    "flow_source_record_ids": {"type": "array", "minItems": 1}
                  },
                  "required": ["flow_source_record_ids"]
                }
              },
              {
                "if": {
                  "properties": {"fx_status": {"const": "CONFIRMED_ONE"}},
                  "required": ["fx_status"]
                },
                "then": {
                  "properties": {
                    "fx_source_record_ids": {"type": "array", "minItems": 1}
                  },
                  "required": ["fx_source_record_ids"]
                }
              }
            ]
          }
        },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "period_capital_method",
            "allocation_endpoint_check"
          ],
          "properties": {
            "period_capital_method": {"const": "NAV_ROLLFORWARD"},
            "allocation_endpoint_check": {
              "type": "object",
              "additionalProperties": false,
              "required": ["matched", "delta_usd"],
              "properties": {
                "matched": {"type": "boolean"},
                "delta_usd": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "hwm_acceptance_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_date",
        "hwm_policy_id",
        "index_base_value"
      ],
      "properties": {
        "anchor_date": {"type": "string", "format": "date"},
        "hwm_policy_id": {"type": "string", "minLength": 1},
        "index_base_value": {"type": "string", "minLength": 1}
      }
    },
    "reconciliation_checks": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "reconciliation_exceptions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "replay": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"const": "PASS"}}
    }
  },
  "allOf": [
    {
      "if": {"required": ["hwm_inputs"]},
      "then": {"required": ["hwm_acceptance_record"]}
    },
    {
      "if": {"required": ["hwm_acceptance_record"]},
      "then": {"required": ["hwm_inputs"]}
    }
  ],
  "$defs": {
    "custody_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_generation_id",
        "ledger_catalog_sha256",
        "ledger_manifest_sha256",
        "admission_receipt_sha256",
        "contract_raw_sha256",
        "contract_semantic_sha256",
        "census_sha256",
        "invested_capital_policy_sha256",
        "census_id"
      ],
      "properties": {
        "ledger_generation_id": {
          "$ref": "#/$defs/sha256"
        },
        "ledger_catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ledger_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "admission_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contract_raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contract_semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "census_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "invested_capital_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "census_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "custody_cash_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_date",
        "record_id",
        "event_sha256",
        "native_currency",
        "native_value",
        "event_time_fx",
        "signed_usd"
      ],
      "properties": {
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "event_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "native_currency": {
          "type": "string",
          "minLength": 1
        },
        "native_value": {
          "type": "string",
          "minLength": 1
        },
        "event_time_fx": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "base_currency",
                "currency",
                "date",
                "field",
                "generation_id",
                "provider",
                "rate",
                "source_artifact_id",
                "timing"
              ],
              "properties": {
                "base_currency": {
                  "type": "string",
                  "minLength": 1
                },
                "currency": {
                  "type": "string",
                  "minLength": 1
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "generation_id": {
                  "type": "string",
                  "minLength": 1
                },
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "rate": {
                  "type": "string",
                  "minLength": 1
                },
                "source_artifact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "timing": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "signed_usd": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "custody_cash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "provider_id",
        "as_of_date",
        "basis",
        "status",
        "current_value",
        "events"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "basis": {
          "const": "DERIVED_ADMITTED_EXTERNAL_FLOWS_MINUS_SLEEVE_ALLOCATIONS_PLUS_REDEMPTIONS"
        },
        "status": {
          "const": "AVAILABLE"
        },
        "current_value": {
          "$ref": "#/$defs/usd_amount"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/custody_cash_event"
          }
        }
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "usd_amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "status", "value"],
      "properties": {
        "currency": {"const": "USD"},
        "status": {"enum": ["AVAILABLE", "UNAVAILABLE"]},
        "value": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "AVAILABLE"}}, "required": ["status"]},
          "then": {"properties": {"value": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "UNAVAILABLE"}}, "required": ["status"]},
          "then": {"properties": {"value": {"type": "null"}}}
        }
      ]
    },
    "capital_status": {"enum": ["AVAILABLE", "NOT_READY_AT_CUTOFF"]},
    "nullable_date": {"type": ["string", "null"], "format": "date"},
    "current_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "as_of_date",
        "assignment_ids",
        "effective_end",
        "effective_start",
        "nav_record_id",
        "source_key",
        "status",
        "value"
      ],
      "properties": {
        "account_id": {"type": "string", "minLength": 1},
        "as_of_date": {"$ref": "#/$defs/nullable_date"},
        "assignment_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "effective_end": {"$ref": "#/$defs/nullable_date"},
        "effective_start": {"$ref": "#/$defs/nullable_date"},
        "nav_record_id": {"type": ["string", "null"]},
        "source_key": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/capital_status"},
        "value": {"$ref": "#/$defs/usd_amount"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "AVAILABLE"}}, "required": ["status"]},
          "then": {
            "properties": {
              "value": {"properties": {"status": {"const": "AVAILABLE"}}},
              "as_of_date": {"type": "string"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "NOT_READY_AT_CUTOFF"}}, "required": ["status"]},
          "then": {
            "properties": {
              "value": {"properties": {"status": {"const": "UNAVAILABLE"}}},
              "as_of_date": {"type": "null"}
            }
          }
        }
      ]
    },
    "reserve_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "as_of_date",
        "authority",
        "nav_record_id",
        "provider",
        "status",
        "value"
      ],
      "properties": {
        "account_id": {"type": "string", "minLength": 1},
        "as_of_date": {"$ref": "#/$defs/nullable_date"},
        "authority": {"enum": ["AUTHORITATIVE", "NAV_NOT_AUTHORITATIVE", "NO_NAV"]},
        "nav_record_id": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/capital_status"},
        "value": {"$ref": "#/$defs/usd_amount"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "AVAILABLE"}}, "required": ["status"]},
          "then": {
            "properties": {
              "authority": {"const": "AUTHORITATIVE"},
              "value": {"properties": {"status": {"const": "AVAILABLE"}}},
              "as_of_date": {"type": "string"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "NOT_READY_AT_CUTOFF"}}, "required": ["status"]},
          "then": {
            "properties": {
              "authority": {"enum": ["NAV_NOT_AUTHORITATIVE", "NO_NAV"]},
              "value": {"properties": {"status": {"const": "UNAVAILABLE"}}},
              "as_of_date": {"type": "null"}
            }
          }
        }
      ]
    },
    "current_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of_date",
        "current_value",
        "current_weight",
        "members",
        "reason",
        "scope",
        "status",
        "strategy_id"
      ],
      "properties": {
        "as_of_date": {"$ref": "#/$defs/nullable_date"},
        "current_value": {"$ref": "#/$defs/usd_amount"},
        "current_weight": {"type": ["string", "null"], "minLength": 1},
        "members": {"type": "array", "items": {"$ref": "#/$defs/current_member"}},
        "derived_cash": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/custody_cash"}},
        "reason": {"type": ["string", "null"], "minLength": 1},
        "scope": {"enum": ["SYSTEMATIC", "RETAINED_EXCLUDED"]},
        "status": {"$ref": "#/$defs/capital_status"},
        "strategy_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "AVAILABLE"}}, "required": ["status"]},
          "then": {
            "properties": {
              "as_of_date": {"type": "string"},
              "current_value": {"properties": {"status": {"const": "AVAILABLE"}}},
              "members": {"minItems": 1},
              "reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "NOT_READY_AT_CUTOFF"}}, "required": ["status"]},
          "then": {
            "properties": {
              "as_of_date": {"type": "null"},
              "current_value": {"properties": {"status": {"const": "UNAVAILABLE"}}},
              "current_weight": {"type": "null"},
              "reason": {"type": "string"}
            }
          }
        },
        {
          "if": {"properties": {"scope": {"const": "RETAINED_EXCLUDED"}}, "required": ["scope"]},
          "then": {"properties": {"current_weight": {"type": "null"}}}
        }
      ]
    },
    "current_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of_date", "components", "current_value", "reason", "status"],
      "properties": {
        "as_of_date": {"$ref": "#/$defs/nullable_date"},
        "components": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "current_value": {"$ref": "#/$defs/usd_amount"},
        "members": {"type": "array", "items": {"$ref": "#/$defs/reserve_member"}},
        "reason": {"type": ["string", "null"], "minLength": 1},
        "status": {"$ref": "#/$defs/capital_status"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "AVAILABLE"}}, "required": ["status"]},
          "then": {
            "properties": {
              "current_value": {"properties": {"status": {"const": "AVAILABLE"}}},
              "reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "NOT_READY_AT_CUTOFF"}}, "required": ["status"]},
          "then": {
            "properties": {
              "as_of_date": {"type": "null"},
              "current_value": {"properties": {"status": {"const": "UNAVAILABLE"}}},
              "reason": {"type": "string"}
            }
          }
        }
      ]
    },
    "current_capital": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "currency",
        "retained_excluded",
        "reserve",
        "strategies",
        "systematic",
        "total_liquid",
        "valuation_date",
        "weight_basis"
      ],
      "properties": {
        "custody_authority": {"$ref": "#/$defs/custody_authority"},
        "basis": {"const": "LATEST_ADMITTED_USD_NAV_ON_OR_BEFORE_VALUATION_DATE"},
        "currency": {"const": "USD"},
        "retained_excluded": {"$ref": "#/$defs/current_aggregate"},
        "reserve": {
          "allOf": [
            {"$ref": "#/$defs/current_aggregate"},
            {"required": ["members"]}
          ]
        },
        "strategies": {"type": "array", "items": {"$ref": "#/$defs/current_strategy"}},
        "systematic": {"$ref": "#/$defs/current_aggregate"},
        "total_liquid": {"$ref": "#/$defs/current_aggregate"},
        "valuation_date": {"type": "string", "format": "date"},
        "weight_basis": {"const": "CURRENT_CUTOFF"}
      }
    },
    "audit_reserve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_observations",
        "account_observations_total_usd",
        "accounts_without_observation",
        "post_observation_flows",
        "source_effective_date",
        "source_key",
        "unexplained_difference_usd",
        "value_usd"
      ],
      "properties": {
        "account_observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["account_id", "as_of_date", "value_usd"],
            "properties": {
              "account_id": {"type": "string", "minLength": 1},
              "as_of_date": {"type": "string", "format": "date"},
              "value_usd": {"type": "string", "minLength": 1}
            }
          }
        },
        "account_observations_total_usd": {"type": "string", "minLength": 1},
        "accounts_without_observation": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "post_observation_flows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["account_id", "amount", "event_date", "flow_type", "record_id"],
            "properties": {
              "account_id": {"type": "string", "minLength": 1},
              "amount": {"type": ["object", "null"]},
              "event_date": {"type": "string", "format": "date"},
              "flow_type": {"type": ["string", "null"]},
              "record_id": {"type": ["string", "null"]}
            }
          }
        },
        "source_effective_date": {"type": "string", "format": "date"},
        "source_key": {"const": "current-portfolio-summary"},
        "unexplained_difference_usd": {"type": "string", "minLength": 1},
        "value_usd": {"type": "string", "minLength": 1}
      }
    },
    "audit_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_source_keys",
        "as_of_date",
        "checks",
        "current_view",
        "replay",
        "reserve",
        "status",
        "systematic_total_usd",
        "total_liquid_usd"
      ],
      "properties": {
        "allocation_source_keys": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reserve", "systematic"],
          "properties": {
            "reserve": {"const": "current-portfolio-summary"},
            "systematic": {"const": "component-decision-table"}
          }
        },
        "as_of_date": {"type": "string", "format": "date"},
        "checks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "status", "value_usd"],
            "properties": {
              "check_id": {
                "enum": [
                  "allocation-to-audit-systematic-total",
                  "allocation-plus-reserve-to-liquid-total"
                ]
              },
              "status": {"const": "PASS"},
              "value_usd": {"type": "string", "minLength": 1}
            }
          }
        },
        "current_view": {"const": "current_capital"},
        "replay": {
          "type": "object",
          "required": ["status"],
          "properties": {"status": {"const": "PASS"}}
        },
        "reserve": {"$ref": "#/$defs/audit_reserve"},
        "status": {"const": "HISTORICAL_REFERENCE"},
        "systematic_total_usd": {"type": "string", "minLength": 1},
        "total_liquid_usd": {"type": "string", "minLength": 1}
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "base_currency", "provider", "role"],
      "properties": {
        "account_id": {"type": "string", "minLength": 1},
        "base_currency": {"const": "USD"},
        "provider": {"type": "string", "minLength": 1},
        "role": {"enum": ["INVESTMENT", "RESERVE"]}
      }
    },
    "calendar_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "provider", "date", "status"],
      "properties": {
        "account_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "date": {"type": ["string", "null"], "format": "date"},
        "status": {
          "enum": [
            "OBSERVED",
            "NON_BUSINESS_WEEKEND",
            "MISSING_ON_PROVIDER_OBSERVED_DATE",
            "UNRESOLVED_NO_CALENDAR_EVIDENCE",
            "NO_ACCOUNT_NAV_OBSERVATIONS"
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_type", "status", "known_gaps"],
      "properties": {
        "fact_type": {"type": "string", "minLength": 1},
        "status": {"enum": ["COMPLETE_WITHIN_DECLARED_BOUNDARY", "PARTIAL", "FAILED"]},
        "known_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "disposition": {"type": "object"},
        "record_count": {"type": "integer", "minimum": 0}
      }
    },
    "fact_coverage_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "admission_effective_end", "admission_effective_start", "authority", "boundary_basis", "cadence", "declared_end", "declared_start", "disposition", "fact_type", "missing_interval_end", "missing_interval_reason", "missing_interval_start", "missing_intervals", "observed_end", "observed_start", "provider_id", "record_count", "status", "unavailable_amount_count"],
      "properties": {
        "account_id": {"type": "string", "minLength": 1},
        "admission_effective_end": {"type": ["string", "null"], "format": "date"},
        "admission_effective_start": {"type": ["string", "null"], "format": "date"},
        "authority": {"type": "string", "minLength": 1},
        "boundary_basis": {"enum": ["OBSERVED_RECORDS_ONLY", "EFFECTIVE_DATED_ADMISSION_NOT_COMPLETENESS", "NO_ACCEPTED_SOURCE"]},
        "cadence": {"enum": ["DAILY", "EVENT_STREAM", "SNAPSHOT"]},
        "declared_end": {"type": ["string", "null"], "format": "date"},
        "declared_start": {"type": ["string", "null"], "format": "date"},
        "disposition": {"type": "string", "minLength": 1},
        "fact_type": {"enum": ["flows", "nav", "positions", "transactions"]},
        "missing_interval_end": {"type": ["string", "null"], "format": "date"},
        "missing_interval_reason": {"type": "string", "minLength": 1},
        "missing_interval_start": {"type": ["string", "null"], "format": "date"},
        "missing_intervals": {"type": "array", "items": {"type": "object"}},
        "observed_end": {"type": ["string", "null"], "format": "date"},
        "observed_start": {"type": ["string", "null"], "format": "date"},
        "provider_id": {"type": "string", "minLength": 1},
        "record_count": {"type": "integer", "minimum": 0},
        "status": {"enum": ["OBSERVED_NOT_COMPLETENESS_PROOF", "OBSERVED_WITH_UNAVAILABLE_AMOUNTS_NOT_COMPLETENESS_PROOF", "NO_REPORTED_EVENTS_NOT_COMPLETENESS_PROOF", "NO_REPORTED_FACT_NOT_COMPLETENESS_PROOF", "NO_ACCEPTED_FACT_PATH"]},
        "unavailable_amount_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
