{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-engine.local/schemas/portfolio/replication-spec.schema.json",
  "title": "Portfolio dynamic replication specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of_date", "method_label", "policy", "schema_version", "sources"],
  "properties": {
    "as_of_date": {"type": "string", "format": "date"},
    "method_label": {"const": "MPI_INFORMED_NON_EQUIVALENT_RESEARCH_REPLICATION"},
    "schema_version": {"const": 1},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_sensitivities_bps",
        "max_absolute_factor_weight",
        "max_gross_factor_exposure",
        "periods_per_year",
        "selected_cost_bps"
      ],
      "properties": {
        "cost_sensitivities_bps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": ["number", "string"], "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}
        },
        "max_absolute_factor_weight": {"type": ["number", "string"]},
        "max_gross_factor_exposure": {"type": ["number", "string"]},
        "periods_per_year": {"type": "integer", "minimum": 1},
        "selected_cost_bps": {"type": ["number", "string"]}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decomposition", "decomposition_generation", "decomposition_generation_id", "factors"],
      "properties": {
        "decomposition": {"$ref": "#/$defs/source"},
        "decomposition_generation": {"$ref": "#/$defs/source"},
        "decomposition_generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "factors": {"$ref": "#/$defs/source"}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
