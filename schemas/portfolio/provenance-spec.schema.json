{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dachent/quant_engine/schemas/portfolio/provenance-spec.schema.json",
  "title": "Private portfolio provenance specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "as_of_date",
    "acquisition_date",
    "roots",
    "source_groups",
    "strategies",
    "strategy_version_catalog",
    "reserve_account",
    "tracker_imports",
    "assumptions"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "policy_version": {"const": "PORT-PERF-1"},
    "as_of_date": {"type": "string", "format": "date"},
    "acquisition_date": {"type": "string", "format": "date"},
    "roots": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "source_groups": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_group"}
    },
    "strategies": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"$ref": "#/$defs/strategy"}
    },
    "strategy_version_catalog": {
      "$ref": "strategy-version-catalog.schema.json"
    },
    "reserve_account": {"$ref": "#/$defs/reserve_account"},
    "tracker_imports": {"$ref": "#/$defs/tracker_imports"},
    "financial_mvp": {"$ref": "#/$defs/financial_mvp"},
    "assumptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/assumption"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(^[A-Za-z]:|^/|\\\\|(^|/)\\.\\.?(/|$))"}
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_id", "relative_path"],
      "properties": {
        "root_id": {"$ref": "#/$defs/identifier"},
        "relative_path": {"$ref": "#/$defs/relative_path"}
      }
    },
    "source_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "root_id",
        "relative_paths",
        "as_of_date",
        "disposition",
        "expected_hashes"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "root_id": {"$ref": "#/$defs/identifier"},
        "relative_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relative_path"}
        },
        "as_of_date": {"type": "string", "format": "date"},
        "disposition": {
          "enum": [
            "AUTHORITATIVE_TRACKER_EVIDENCE",
            "GENERATED_DERIVATIVE",
            "HISTORICAL_REFERENCE",
            "PRODUCING_CODE",
            "PROVENANCE_ANCHOR",
            "SEMANTIC_REFERENCE",
            "STATIC_LINEAGE_MAP"
          ]
        },
        "expected_hashes": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/relative_path"},
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "evidence_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "evidence_layer", "purpose"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "evidence_layer": {
          "enum": [
            "ACCOUNT_LIVE",
            "PROVIDER_LIVE",
            "OFFICIAL_VEHICLE",
            "PREDECESSOR",
            "SHADOW_OOS",
            "BACKTEST",
            "CONCEPTUAL_STRESS"
          ]
        },
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_id",
        "name",
        "aliases",
        "economic_family",
        "evidence_routes",
        "version_ref",
        "cost_status",
        "coverage_status",
        "gaps"
      ],
      "properties": {
        "strategy_id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "economic_family": {"type": "string", "minLength": 1},
        "evidence_routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_route"}},
        "version_ref": {"type": ["string", "null"]},
        "cost_status": {"enum": ["KNOWN", "PARTIAL", "UNAVAILABLE"]},
        "coverage_status": {"enum": ["COMPLETE_WITHIN_DECLARED_BOUNDARY", "PARTIAL", "FAILED"]},
        "gaps": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "reserve_account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "name", "aliases", "source_routes"],
      "properties": {
        "account_id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "tracker_imports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignments", "corrections", "open_gaps", "unmapped_labels"],
      "properties": {
        "assignments": {"$ref": "#/$defs/source_ref"},
        "corrections": {"$ref": "#/$defs/source_ref"},
        "open_gaps": {"$ref": "#/$defs/source_ref"},
        "unmapped_labels": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "financial_mvp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_path",
        "contract_sha256",
        "registry_path",
        "registry_sha256",
        "schema_path",
        "schema_sha256"
      ],
      "properties": {
        "contract_path": {"type": "string", "minLength": 1},
        "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "registry_path": {"type": "string", "minLength": 1},
        "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_path": {"type": "string", "minLength": 1},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption_id", "description", "status", "source_routes"],
      "properties": {
        "assumption_id": {"$ref": "#/$defs/identifier"},
        "description": {"type": "string", "minLength": 1},
        "status": {"enum": ["ACCEPTED", "INFERRED", "UNRESOLVED"]},
        "source_routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}
      }
    }
  }
}
