{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dachent/quant_engine/schemas/portfolio/release-cycle-manifest.schema.json",
  "title": "Release cycle manifest (RELEASE-DRIVER-001, hand-script replacement block B0)",
  "description": "One hash-pinned declaration per release cycle: dates, provider generations, finality evidence, strategy evidence, cost inputs and public bundle roots. Every path is a {root_key, relative} pair; the root keys are bound to directories by the run, never by this file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cycle_id",
    "cutoff",
    "evaluated_on",
    "captured_at_utc",
    "predecessor",
    "scratch",
    "providers",
    "strategy_evidence"
  ],
  "properties": {
    "schema_version": { "const": "qe-release-cycle-manifest/1" },
    "cycle_id": { "$ref": "#/$defs/name" },
    "cutoff": { "$ref": "#/$defs/date" },
    "evaluated_on": { "$ref": "#/$defs/date" },
    "captured_at_utc": { "$ref": "#/$defs/utc" },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id"],
      "properties": {
        "release_id": { "$ref": "#/$defs/name" },
        "release_manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scratch": { "$ref": "#/$defs/ref" },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alpaca", "fidelity", "ibkr", "matrixport", "portfolio123", "quantbase", "schwab"],
      "properties": {
        "alpaca": { "$ref": "#/$defs/provider", "properties": { "finality_source": { "const": "GENERATION_MANIFEST" } } },
        "fidelity": { "$ref": "#/$defs/provider", "properties": { "finality_source": { "const": "GENERATION_MANIFEST" } } },
        "ibkr": { "$ref": "#/$defs/provider", "properties": { "finality_source": { "const": "SELECTED_SOURCE_ARTIFACT" } } },
        "matrixport": { "$ref": "#/$defs/provider", "properties": { "finality_source": { "const": "CYCLE_MANIFEST_NATIVE" } } },
        "portfolio123": { "$ref": "#/$defs/provider", "properties": { "finality_source": { "const": "GENERATION_MANIFEST" } } },
        "quantbase": { "$ref": "#/$defs/provider", "properties": { "finality_source": { "const": "CYCLE_MANIFEST_NATIVE" } } },
        "schwab": { "$ref": "#/$defs/provider", "properties": { "finality_source": { "const": "CYCLE_MANIFEST_NATIVE" } } }
      }
    },
    "strategy_evidence": { "$ref": "#/$defs/pin" },
    "epoch_admission_policy": { "$ref": "#/$defs/pin" },
    "cost_inputs": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/pin" }
    },
    "public_bundles": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/ref" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_key", "relative"],
      "properties": {
        "root_key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$" },
        "relative": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/ref" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "generation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "generation_id"],
          "properties": {
            "mode": { "const": "explicit" },
            "generation_id": { "$ref": "#/$defs/name" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "single" } }
        }
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "generation", "manifest_sha256", "finality_source", "qualification"],
      "properties": {
        "qualification": {
          "enum": ["PUBLISHED_COMPLETE", "STAGED_COMPLETE", "ACCEPTED_PARTIAL", "FINITE_STATIC"]
        },
        "finalized_through": { "$ref": "#/$defs/date" },
        "finality_source": {
          "enum": ["GENERATION_MANIFEST", "SELECTED_SOURCE_ARTIFACT", "CYCLE_MANIFEST_NATIVE"]
        },
        "root": { "$ref": "#/$defs/ref" },
        "generation": { "$ref": "#/$defs/generation" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "finality_evidence": { "$ref": "#/$defs/pin" }
      }
    }
  }
}
