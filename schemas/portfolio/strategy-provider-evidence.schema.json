{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dachent/quant_engine/schemas/portfolio/strategy-provider-evidence.schema.json",
  "title": "Current strategy provider evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of_date", "schema_version", "strategies"],
  "properties": {
    "as_of_date": { "type": "string", "format": "date" },
    "schema_version": { "const": 1 },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/strategyEvidence" }
    }
  },
  "$defs": {
    "date": { "type": "string", "format": "date" },
    "decimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "accountPath": {
      "type": "object",
      "required": ["observed_end", "observed_start", "return_observations"],
      "properties": {
        "cumulative_return": { "$ref": "#/$defs/decimal" },
        "current_drawdown": { "$ref": "#/$defs/decimal" },
        "maximum_drawdown": { "$ref": "#/$defs/decimal" },
        "observed_end": { "$ref": "#/$defs/date" },
        "observed_start": { "$ref": "#/$defs/date" },
        "return_observations": { "type": "integer", "minimum": 1 }
      }
    },
    "strategyEvidence": {
      "type": "object",
      "required": [
        "account",
        "evidence_layer",
        "generation_as_of_date",
        "generation_id",
        "provider_id",
        "sources",
        "strategy_id",
        "strategy_name"
      ],
      "properties": {
        "account": { "$ref": "#/$defs/accountPath" },
        "current_snapshot": { "type": "object" },
        "evidence_layer": { "type": "string", "minLength": 1 },
        "generation_as_of_date": { "$ref": "#/$defs/date" },
        "generation_id": { "$ref": "#/$defs/hash" },
        "overlap": { "type": "object" },
        "provider": { "$ref": "#/$defs/accountPath" },
        "provider_id": { "type": "string", "minLength": 1 },
        "sources": { "type": "object" },
        "strategy_id": { "type": "string", "minLength": 1 },
        "strategy_name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
