{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-engine.local/schemas/portfolio/base-decomposition-spec.schema.json",
  "title": "Base decomposition specification",
  "description": "The specification the current-decomposition planner writes and the decomposition producer consumes. It crossed that seam with no schema, so a structurally drifted target_source.interval_policy could not be rejected: a template produced before source-period interval policy existed carried series_policies entries with empty source_segments and empty declared_unavailable_labels, the producer could not reach its SOURCE_SEGMENT_GAP tolerance path, and the run stopped on the first declared provider NAV gap. Every series policy must therefore declare its segments and its unavailable labels explicitly, even when both are empty, so an absent declaration is distinguishable from a declared absence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_lens",
    "as_of_date",
    "evidence_mode",
    "factor_source",
    "maximum_factor_staleness_days",
    "models",
    "provenance_sources",
    "schema_version",
    "series_composition",
    "target_source"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "analysis_lens": { "type": "string", "minLength": 1 },
    "as_of_date": { "type": "string", "format": "date" },
    "evidence_mode": { "enum": ["LIVE_ONLY", "LIVE_PLUS_BACKTEST"] },
    "maximum_factor_staleness_days": { "type": "integer", "minimum": 0 },
    "series_composition": {
      "description": "Per-series layered composition, keyed by series identifier.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "object" }
    },
    "target_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "expected_sha256",
        "expected_size_bytes",
        "interval_policy",
        "relative_path",
        "schema_name",
        "schema_version"
      ],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "relative_path": { "type": "string", "minLength": 1 },
        "schema_name": { "type": "string", "minLength": 1 },
        "schema_version": { "type": ["string", "integer"] },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "expected_size_bytes": { "type": "integer", "minimum": 0 },
        "interval_policy": { "$ref": "#/$defs/targetIntervalPolicy" }
      }
    },
    "factor_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "date_column",
        "expected_sha256",
        "expected_size_bytes",
        "factors",
        "relative_path",
        "schema_name",
        "schema_version"
      ],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "relative_path": { "type": "string", "minLength": 1 },
        "schema_name": { "type": "string", "minLength": 1 },
        "schema_version": { "type": ["string", "integer"] },
        "date_column": { "type": "string", "minLength": 1 },
        "risk_free_column": { "type": "string", "minLength": 1 },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "expected_size_bytes": { "type": "integer", "minimum": 0 },
        "interval_policy": { "type": "object" },
        "factors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["column", "factor_id"],
            "properties": {
              "column": { "type": "string", "minLength": 1 },
              "factor_id": { "type": "string", "minLength": 1 },
              "return_type": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "provenance_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "expected_sha256",
          "expected_size_bytes",
          "relative_path",
          "schema_name",
          "schema_version"
        ],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "relative_path": { "type": "string", "minLength": 1 },
          "schema_name": { "type": "string", "minLength": 1 },
          "schema_version": { "type": ["string", "integer"] },
          "expected_sha256": { "$ref": "#/$defs/sha256" },
          "expected_size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "constraint",
          "cost_coverage",
          "cv_folds",
          "factor_ids",
          "minimum_test_observations",
          "minimum_train_observations",
          "model_id",
          "parsimony_tolerance",
          "periods_per_year",
          "ridge_candidates",
          "series_id",
          "test_start",
          "train_end"
        ],
        "properties": {
          "model_id": { "type": "string", "minLength": 1 },
          "series_id": { "type": "string", "minLength": 1 },
          "constraint": { "type": "string", "minLength": 1 },
          "cost_coverage": { "type": "string", "minLength": 1 },
          "estimator": { "type": "string", "minLength": 1 },
          "cv_folds": { "type": "integer", "minimum": 2 },
          "factor_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "minimum_train_observations": { "type": "integer", "minimum": 1 },
          "minimum_test_observations": { "type": "integer", "minimum": 1 },
          "parsimony_tolerance": { "type": "string" },
          "periods_per_year": { "type": "integer", "minimum": 1 },
          "ridge_candidates": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "smoothness_candidates": { "type": "array", "items": { "type": "string" } },
          "train_end": { "type": "string", "format": "date" },
          "test_start": { "type": "string", "format": "date" },
          "as_of_date": { "type": "string", "format": "date" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "targetIntervalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "evaluation_information_set", "series_policies"],
      "properties": {
        "currency": { "type": "string", "minLength": 1 },
        "evaluation_information_set": { "type": "string", "minLength": 1 },
        "series_policies": {
          "description": "One policy per composed series. A series present in series_composition and absent here is the drift this schema exists to reject.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/seriesIntervalPolicy" }
        }
      }
    },
    "seriesIntervalPolicy": {
      "type": "object",
      "required": [
        "declared_unavailable_labels",
        "finality",
        "gap_disposition",
        "native_calendar",
        "native_label_convention",
        "return_basis",
        "source_segments",
        "source_vintage"
      ],
      "properties": {
        "finality": { "type": "string", "minLength": 1 },
        "finalized_through": { "type": "string", "format": "date" },
        "gap_disposition": { "type": "string", "minLength": 1 },
        "native_calendar": { "type": "string", "minLength": 1 },
        "native_label_convention": { "type": "string", "minLength": 1 },
        "return_basis": { "type": "string", "minLength": 1 },
        "source_vintage": { "type": "string", "minLength": 1 },
        "declared_unavailable_labels": {
          "description": "Labels the provider declared unavailable, each with the reason and the source generation that declared it. Required even when empty: an absent declaration must not be indistinguishable from a declared absence, and an unexplained one must not be admissible at all.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "reason", "source_reference"],
            "properties": {
              "date": { "type": "string", "format": "date" },
              "reason": { "type": "string", "minLength": 1 },
              "source_reference": {
                "type": "object",
                "required": ["generation_id", "manifest_sha256", "source_id"],
                "properties": {
                  "source_id": { "type": "string", "minLength": 1 },
                  "generation_id": { "$ref": "#/$defs/sha256" },
                  "manifest_sha256": { "$ref": "#/$defs/sha256" },
                  "declared_exclusion_item": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "source_segments": {
          "description": "Observed segments of this series. An empty array means the series genuinely has none, not that the planner failed to compute them.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "observed_start",
              "observed_end",
              "segment_id",
              "source_vintage"
            ],
            "properties": {
              "observed_start": { "type": "string", "format": "date" },
              "observed_end": { "type": "string", "format": "date" },
              "segment_id": { "type": "string", "minLength": 1 },
              "source_vintage": { "type": "string", "minLength": 1 }
            }
          }
        },
        "session_schedule_labels": {
          "description": "Declared session labels, keyed by series identifier, for series whose native calendar is SESSION_LABELLED.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "format": "date" }
          }
        }
      }
    }
  }
}
