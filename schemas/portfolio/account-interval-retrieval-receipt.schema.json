{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dachent/quant_engine/schemas/portfolio/account-interval-retrieval-receipt.schema.json",
  "oneOf": [{"$ref": "#/$defs/retrieval_v2"}, {"$ref": "#/$defs/static_snapshot_v1"}],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "as_of_date", "schema", "sha256", "size_bytes"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "as_of_date": {"$ref": "#/$defs/date"}, "schema": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "issuer": {"type": "object", "additionalProperties": false, "required": ["adapter_name", "adapter_version", "code_sha256"], "properties": {"adapter_name": {"type": "string", "minLength": 1}, "adapter_version": {"type": "string", "minLength": 1}, "code_sha256": {"$ref": "#/$defs/sha256"}}},
    "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "pagination": {"type": "object", "additionalProperties": false, "required": ["mode", "page_count", "request_response_chain_sha256", "terminal_response_sha256", "terminal"], "properties": {"mode": {"type": "string", "minLength": 1}, "page_count": {"type": "integer", "minimum": 1}, "request_response_chain_sha256": {"$ref": "#/$defs/sha256"}, "terminal_response_sha256": {"$ref": "#/$defs/sha256"}, "terminal": {"const": true}}},
    "retrieval_v2": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_id", "issuer", "provider", "provider_generation", "provider_generation_manifest", "raw_evidence_artifacts", "account_id", "source_account_identity_sha256", "requested_start", "requested_end", "covered_start", "covered_end", "required_categories", "completed_categories", "unavailable_categories", "pagination", "completeness", "truncated"], "properties": {"schema_version": {"const": 2}, "artifact_id": {"type": "string", "minLength": 1}, "issuer": {"$ref": "#/$defs/issuer"}, "provider": {"type": "string", "minLength": 1}, "provider_generation": {"$ref": "#/$defs/sha256"}, "provider_generation_manifest": {"$ref": "#/$defs/artifact"}, "raw_evidence_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}}, "account_id": {"type": "string", "minLength": 1}, "source_account_identity_sha256": {"$ref": "#/$defs/sha256"}, "requested_start": {"$ref": "#/$defs/date"}, "requested_end": {"$ref": "#/$defs/date"}, "covered_start": {"$ref": "#/$defs/date"}, "covered_end": {"$ref": "#/$defs/date"}, "required_categories": {"$ref": "#/$defs/categories"}, "completed_categories": {"$ref": "#/$defs/categories"}, "unavailable_categories": {"const": []}, "pagination": {"$ref": "#/$defs/pagination"}, "completeness": {"const": "EXACT_ACCOUNT_INTERVAL_ALL_APPLICABLE_CATEGORIES"}, "truncated": {"const": false}}},
    "fact_summary": {"type": "object", "additionalProperties": false, "required": ["row_count", "first_date", "last_date"], "properties": {"row_count": {"type": "integer", "minimum": 0}, "first_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}, "last_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"row_count": {"const": 0}}}, "then": {"properties": {"first_date": {"type": "null"}, "last_date": {"type": "null"}}}}, {"if": {"properties": {"row_count": {"minimum": 1}}}, "then": {"properties": {"first_date": {"$ref": "#/$defs/date"}, "last_date": {"$ref": "#/$defs/date"}}}}]},
    "static_snapshot_v1": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_id", "coverage_mode", "issuer", "provider", "account_id", "strategy_id", "requested_start", "requested_end", "calculation_cutoff_date", "date_convention", "provider_generation", "staged_inputs", "observed_facts", "missing_intervals", "coverage_as_of_date", "completeness"], "properties": {"schema_version": {"const": 3}, "artifact_id": {"type": "string", "minLength": 1}, "coverage_mode": {"const": "STATIC_SNAPSHOT_COVERAGE_V1"}, "issuer": {"$ref": "#/$defs/issuer"}, "provider": {"type": "string", "minLength": 1}, "account_id": {"type": "string", "minLength": 1}, "strategy_id": {"type": "string", "minLength": 1}, "requested_start": {"$ref": "#/$defs/date"}, "requested_end": {"$ref": "#/$defs/date"}, "calculation_cutoff_date": {"$ref": "#/$defs/date"}, "date_convention": {"const": "EOD_PROVIDER_NAV_RECOGNITION_DATE"}, "provider_generation": {"type": "object", "additionalProperties": false, "required": ["generation_id", "catalog_sha256", "manifest_sha256", "generation_as_of_date"], "properties": {"generation_id": {"$ref": "#/$defs/sha256"}, "catalog_sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "generation_as_of_date": {"$ref": "#/$defs/date"}}}, "staged_inputs": {"type": "object", "additionalProperties": false, "required": ["provider_ledger_generation_id", "provider_ledger_artifact", "baseline_sha256", "baseline_size_bytes", "crosswalk_sha256", "crosswalk_size_bytes"], "properties": {"provider_ledger_generation_id": {"$ref": "#/$defs/sha256"}, "provider_ledger_artifact": {"$ref": "#/$defs/artifact"}, "baseline_sha256": {"$ref": "#/$defs/sha256"}, "baseline_size_bytes": {"type": "integer", "minimum": 0}, "crosswalk_sha256": {"$ref": "#/$defs/sha256"}, "crosswalk_size_bytes": {"type": "integer", "minimum": 0}}}, "observed_facts": {"type": "object", "additionalProperties": false, "required": ["nav", "flows", "capital_anchors"], "properties": {"nav": {"$ref": "#/$defs/fact_summary"}, "flows": {"$ref": "#/$defs/fact_summary"}, "capital_anchors": {"$ref": "#/$defs/fact_summary"}}}, "missing_intervals": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["start", "end", "reason"], "properties": {"start": {"$ref": "#/$defs/date"}, "end": {"$ref": "#/$defs/date"}, "reason": {"const": "PROVIDER_DECLARED_NAV_MISSING"}}}}, "coverage_as_of_date": {"$ref": "#/$defs/date"}, "completeness": {"const": "RETAINED_STATIC_SNAPSHOT_ONLY"}}}
  }
}
