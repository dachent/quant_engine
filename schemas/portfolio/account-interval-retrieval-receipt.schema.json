{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dachent/quant_engine/schemas/portfolio/account-interval-retrieval-receipt.schema.json",
  "title": "Closed account interval retrieval receipt v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "issuer", "provider", "provider_generation", "provider_generation_manifest", "raw_evidence_artifacts", "account_id", "source_account_identity_sha256", "requested_start", "requested_end", "covered_start", "covered_end", "required_categories", "completed_categories", "unavailable_categories", "pagination", "completeness", "truncated"],
  "properties": {
    "schema_version": {"const": 2}, "artifact_id": {"type": "string", "minLength": 1},
    "issuer": {"type": "object", "additionalProperties": false, "required": ["adapter_name", "adapter_version", "code_sha256"], "properties": {"adapter_name": {"type": "string", "minLength": 1}, "adapter_version": {"type": "string", "minLength": 1}, "code_sha256": {"$ref": "#/$defs/sha256"}}},
    "provider": {"type": "string", "minLength": 1}, "provider_generation": {"$ref": "#/$defs/sha256"}, "provider_generation_manifest": {"$ref": "#/$defs/artifact"}, "raw_evidence_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "account_id": {"type": "string", "minLength": 1}, "source_account_identity_sha256": {"$ref": "#/$defs/sha256"}, "requested_start": {"$ref": "#/$defs/date"}, "requested_end": {"$ref": "#/$defs/date"}, "covered_start": {"$ref": "#/$defs/date"}, "covered_end": {"$ref": "#/$defs/date"},
    "required_categories": {"$ref": "#/$defs/categories"}, "completed_categories": {"$ref": "#/$defs/categories"}, "unavailable_categories": {"type": "array", "maxItems": 0},
    "pagination": {"type": "object", "additionalProperties": false, "required": ["mode", "page_count", "request_response_chain_sha256", "terminal_response_sha256", "terminal"], "properties": {"mode": {"type": "string", "minLength": 1}, "page_count": {"type": "integer", "minimum": 1}, "request_response_chain_sha256": {"$ref": "#/$defs/sha256"}, "terminal_response_sha256": {"$ref": "#/$defs/sha256"}, "terminal": {"const": true}}},
    "completeness": {"const": "EXACT_ACCOUNT_INTERVAL_ALL_APPLICABLE_CATEGORIES"}, "truncated": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "optional_categories": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "as_of_date", "schema", "sha256", "size_bytes"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "as_of_date": {"$ref": "#/$defs/date"}, "schema": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}}
  }
}
