{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dachent/quant_engine/schemas/portfolio/control-recomputation.schema.json",
  "title": "Independent portfolio control recomputation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of_date", "component_count", "declared_values", "differences", "generation_checks", "inputs", "method", "recomputed_correlation_one_stress", "receipt_schema_version", "status", "tolerance"],
  "properties": {
    "as_of_date": {"type": "string", "format": "date"},
    "component_count": {"type": "integer", "minimum": 1},
    "declared_values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation_stress", "panel_headline", "report_headline"],
      "properties": {
        "correlation_stress": {"$ref": "#/$defs/decimal"},
        "panel_headline": {"$ref": "#/$defs/decimal"},
        "report_headline": {"$ref": "#/$defs/decimal"}
      }
    },
    "differences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation_declared", "declared_contribution_sum", "maximum_component", "panel_headline", "report_headline"],
      "properties": {
        "correlation_declared": {"$ref": "#/$defs/decimal"},
        "declared_contribution_sum": {"$ref": "#/$defs/decimal"},
        "maximum_component": {"$ref": "#/$defs/decimal"},
        "panel_headline": {"$ref": "#/$defs/decimal"},
        "report_headline": {"$ref": "#/$defs/decimal"}
      }
    },
    "generation_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freshness_matches_current_provider_ledger", "panel_correlation_matches_current", "panel_freshness_matches_selected", "panel_report_matches_current"],
      "properties": {
        "freshness_matches_current_provider_ledger": {"const": true},
        "panel_correlation_matches_current": {"const": true},
        "panel_freshness_matches_selected": {"const": true},
        "panel_report_matches_current": {"const": true}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation", "freshness", "panel", "provider_ledger", "report"],
      "properties": {
        "correlation": {"$ref": "#/$defs/generationIdentity"},
        "freshness": {"$ref": "#/$defs/freshnessIdentity"},
        "panel": {"$ref": "#/$defs/panelIdentity"},
        "provider_ledger": {"$ref": "#/$defs/providerLedgerIdentity"},
        "report": {"$ref": "#/$defs/generationIdentity"}
      }
    },
    "method": {"const": "DECIMAL_SUM_ALLOCATION_WEIGHT_TIMES_CONSERVATIVE_LOSS_FRACTION"},
    "recomputed_correlation_one_stress": {"$ref": "#/$defs/decimal"},
    "receipt_schema_version": {"const": 2},
    "status": {"const": "PASS"},
    "tolerance": {"const": "0.000000000001"}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "freshnessIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of_date", "path", "sha256", "size_bytes"],
      "properties": {
        "as_of_date": {"type": "string", "format": "date"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "generationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of_date", "generation_id", "path", "sha256", "size_bytes"],
      "properties": {
        "as_of_date": {"type": "string", "format": "date"},
        "generation_id": {"$ref": "#/$defs/hash"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "panelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_dir", "candidate_record", "dashboard", "declared_freshness_sha256", "freshness", "panel_id"],
      "properties": {
        "candidate_dir": {"type": "string", "minLength": 1},
        "candidate_record": {"$ref": "#/$defs/fileIdentity"},
        "dashboard": {"$ref": "#/$defs/fileIdentity"},
        "declared_freshness_sha256": {"$ref": "#/$defs/hash"},
        "freshness": {"$ref": "#/$defs/fileIdentity"},
        "panel_id": {"$ref": "#/$defs/hash"}
      }
    },
    "providerLedgerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of_date", "catalog", "generation_id", "manifest"],
      "properties": {
        "as_of_date": {"type": "string", "format": "date"},
        "catalog": {"$ref": "#/$defs/fileIdentity"},
        "generation_id": {"$ref": "#/$defs/hash"},
        "manifest": {"$ref": "#/$defs/fileIdentity"}
      }
    }
  }
}
