{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dachent/quant_engine/schemas/portfolio/control-panel-data.schema.json",
  "title": "Portfolio control panel data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "account_summary",
    "advisory",
    "allocations",
    "blocking_items",
    "candidate_appendix",
    "capital",
    "counts",
    "coverage",
    "dependence_analysis",
    "factor_analysis",
    "fact_status",
    "gates",
    "hwm_summary",
    "limitations",
    "meta",
    "panel_schema_version",
    "performance",
    "positions",
    "provenance",
    "provider_counts",
    "reconciliation_checks",
    "strategies"
  ],
  "properties": {
    "panel_schema_version": { "const": 4 },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_generation_id", "correlation_generation_id", "correlation_sha256", "decomposition_generation_id", "decomposition_sha256", "hwm_policy_sha256", "panel_mode", "portfolio_as_of", "report_generation_id", "report_sha256", "source_shell_hashes", "strategy_evidence_as_of", "strategy_evidence_sha256", "template_hashes"],
      "properties": {
        "baseline_generation_id": { "$ref": "#/$defs/hash" },
        "correlation_generation_id": { "$ref": "#/$defs/hash" },
        "correlation_sha256": { "$ref": "#/$defs/hash" },
        "decomposition_generation_id": { "$ref": "#/$defs/hash" },
        "decomposition_sha256": { "$ref": "#/$defs/hash" },
        "hwm_policy_sha256": { "$ref": "#/$defs/hash" },
        "panel_mode": { "const": "LOCAL_DIRECT_FILE_READ_ONLY" },
        "portfolio_as_of": { "type": "string", "format": "date" },
        "report_generation_id": { "$ref": "#/$defs/hash" },
        "report_sha256": { "$ref": "#/$defs/hash" },
        "source_shell_hashes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } },
        "strategy_evidence_as_of": { "type": ["string", "null"], "format": "date" },
        "strategy_evidence_sha256": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "template_hashes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } }
      }
    },
    "capital": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reserve", "systematic", "total_liquid"],
      "properties": {
        "reserve": { "$ref": "#/$defs/decimal" },
        "systematic": { "$ref": "#/$defs/decimal" },
        "total_liquid": { "$ref": "#/$defs/decimal" }
      }
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation_one_stress", "hwm_limit", "hwm_status", "nav_coverage", "readiness", "reason"],
      "properties": {
        "correlation_one_stress": { "$ref": "#/$defs/decimal" },
        "hwm_limit": { "$ref": "#/$defs/decimal" },
        "hwm_status": { "type": "string" },
        "nav_coverage": { "$ref": "#/$defs/decimal" },
        "readiness": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "candidate_appendix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of_date", "providers", "source_sha256", "status", "tier_counts"],
      "properties": {
        "as_of_date": { "type": "string", "format": "date" },
        "providers": { "type": "array", "minItems": 33, "maxItems": 33, "items": { "type": "object" } },
        "source_sha256": { "$ref": "#/$defs/hash" },
        "status": { "const": "FROZEN_AUDIT_APPENDIX" },
        "tier_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "account_summary": { "$ref": "#/$defs/rows" },
    "allocations": { "$ref": "#/$defs/rows" },
    "blocking_items": { "$ref": "#/$defs/rows" },
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "coverage": { "$ref": "#/$defs/rows" },
    "dependence_analysis": {
      "type": "object",
      "required": ["analytics_hash", "as_of_date", "available_pair_count", "cells", "correlation_one", "generation_id", "matrices", "pair_count", "series_ids", "source_sha256"],
      "properties": {
        "analytics_hash": { "$ref": "#/$defs/hash" },
        "as_of_date": { "type": "string", "format": "date" },
        "available_pair_count": { "type": "integer", "minimum": 0 },
        "cells": { "type": "array", "minItems": 36, "maxItems": 36, "items": { "type": "object" } },
        "correlation_one": { "type": "object" },
        "generation_id": { "$ref": "#/$defs/hash" },
        "matrices": { "type": "object", "minProperties": 6, "maxProperties": 6 },
        "pair_count": { "const": 36 },
        "series_ids": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "string" }, "uniqueItems": true },
        "source_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "factor_analysis": {
      "type": "object",
      "required": ["analytics_hash", "as_of_date", "available_count", "dynamic_available_count", "generation_id", "method_label", "methodology_manifest_sha256", "methodology_version", "series", "source_sha256", "sources", "unavailable_count"],
      "properties": {
        "analytics_hash": { "$ref": "#/$defs/hash" },
        "as_of_date": { "type": "string", "format": "date" },
        "available_count": { "type": "integer", "minimum": 0 },
        "dynamic_available_count": { "type": "integer", "minimum": 0 },
        "generation_id": { "$ref": "#/$defs/hash" },
        "method_label": { "const": "MPI_INFORMED_NON_EQUIVALENT" },
        "methodology_manifest_sha256": { "$ref": "#/$defs/hash" },
        "methodology_version": { "type": "string" },
        "series": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "object" } },
        "source_sha256": { "$ref": "#/$defs/hash" },
        "sources": { "type": "object" },
        "unavailable_count": { "type": "integer", "minimum": 0 }
      }
    },
    "fact_status": { "type": "object", "additionalProperties": { "type": "string" } },
    "gates": { "$ref": "#/$defs/rows" },
    "hwm_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered_value_usd", "excluded_strategies", "excluded_value_usd", "material_value_usd", "nav_coverage", "status", "uncovered_strategies"],
      "properties": {
        "covered_value_usd": { "$ref": "#/$defs/decimal" },
        "excluded_value_usd": { "$ref": "#/$defs/decimal" },
        "excluded_strategies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "material_value_usd": { "$ref": "#/$defs/decimal" },
        "nav_coverage": { "$ref": "#/$defs/decimal" },
        "status": { "type": "string" },
        "uncovered_strategies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "performance": { "$ref": "#/$defs/rows" },
    "positions": { "$ref": "#/$defs/rows" },
    "provenance": { "$ref": "#/$defs/rows" },
    "provider_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "reconciliation_checks": { "$ref": "#/$defs/rows" },
    "strategies": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "object" } }
  },
  "$defs": {
    "decimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rows": { "type": "array", "items": { "type": "object" } }
  }
}
