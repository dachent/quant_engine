{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dachent/quant_engine/schemas/portfolio/hwm-input-generation.schema.json",
  "title": "Portable PORT-HWM-4 input authority receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "builder",
    "builder_version",
    "authority_profile",
    "authority_bindings",
    "upstream_receipt_sha256",
    "maximum_age_days",
    "evidence_sha256s",
    "flow_events"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "builder": {"const": "portfolio-hwm-inputs"},
    "builder_version": {"const": "0.2.0"},
    "authority_profile": {"const": "PORTABLE_SYNTHETIC"},
    "authority_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_sha256",
        "policy_semantic_digest",
        "product_contract_sha256",
        "performance_policy_sha256",
        "legacy_policy_sha256",
        "calendar_sha256"
      ],
      "properties": {
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "policy_semantic_digest": {"$ref": "#/$defs/sha256"},
        "product_contract_sha256": {"$ref": "#/$defs/sha256"},
        "performance_policy_sha256": {"$ref": "#/$defs/sha256"},
        "legacy_policy_sha256": {"$ref": "#/$defs/sha256"},
        "calendar_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "upstream_receipt_sha256": {"type": "null"},
    "maximum_age_days": {"type": "integer", "minimum": 0},
    "evidence_sha256s": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "flow_events": {
      "type": "array",
      "items": {"$ref": "#/$defs/flow_event"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "flow_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "strategy_id",
        "interval_id",
        "subperiod_id",
        "event_type",
        "capital_treatment",
        "effective_at_utc",
        "effective_timezone",
        "timing_basis",
        "original_amount",
        "original_currency",
        "fx_rate_to_usd",
        "fx_authority_id",
        "fx_generation_sha256",
        "usd_amount",
        "correction_kind",
        "related_event_id",
        "classification_authority_sha256",
        "event_evidence_sha256"
      ],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "strategy_id": {"type": "string", "minLength": 1},
        "interval_id": {"type": "string", "minLength": 1},
        "subperiod_id": {"type": "string", "minLength": 1},
        "event_type": {
          "enum": [
            "OWNER_CONTRIBUTION",
            "OWNER_WITHDRAWAL",
            "IN_KIND_FUNDING",
            "OPENING_BASIS",
            "OWNER_BOUNDARY_PREDECESSOR_TRANSITION",
            "INTERNAL_TRANSFER",
            "PREDECESSOR_TRANSITION",
            "MARGIN_BORROW",
            "MARGIN_REPAYMENT",
            "FINANCING_COST",
            "DIVIDEND",
            "INTEREST",
            "REINVESTMENT",
            "FEE",
            "TAX",
            "EXPENSE",
            "REBATE"
          ]
        },
        "capital_treatment": {
          "enum": [
            "EXTERNAL_FLOW",
            "INTERNAL_TRANSFER",
            "MARGIN_PRINCIPAL",
            "FINANCING_COST",
            "INVESTMENT_RESULT"
          ]
        },
        "effective_at_utc": {"$ref": "#/$defs/utc_timestamp"},
        "effective_timezone": {"type": "string", "minLength": 1},
        "timing_basis": {
          "enum": ["EXACT_TIMESTAMP", "DATE_ONLY_END_OF_DAY"]
        },
        "original_amount": {"$ref": "#/$defs/decimal"},
        "original_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "fx_rate_to_usd": {"$ref": "#/$defs/decimal"},
        "fx_authority_id": {"type": "string", "minLength": 1},
        "fx_generation_sha256": {"$ref": "#/$defs/sha256"},
        "usd_amount": {"$ref": "#/$defs/decimal"},
        "correction_kind": {
          "enum": ["ORIGINAL", "SOURCE_CORRECTION", "ECONOMIC_REVERSAL"]
        },
        "related_event_id": {
          "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
        },
        "classification_authority_sha256": {"$ref": "#/$defs/sha256"},
        "event_evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
