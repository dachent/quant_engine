{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dachent/quant_engine/schemas/portfolio/financial-mvp-source-contract.schema.json",
  "title": "Financial MVP and source-segment contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_schema_version",
    "financial_outcomes",
    "golden_case",
    "history_corrections",
    "product",
    "source_segments",
    "strategies"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/portfolio/financial-mvp-source-contract.schema.json"
    },
    "contract_schema_version": {"const": 4},
    "product": {"$ref": "#/$defs/product"},
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/strategy"}
    },
    "financial_outcomes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/outcome"}
    },
    "source_segments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_segment"}
    },
    "history_corrections": {"$ref": "#/$defs/history_corrections"},
    "golden_case": {"$ref": "#/$defs/golden_case"}
  },
  "$defs": {
    "date_or_null": {
      "type": ["string", "null"],
      "format": "date"
    },
    "hash_or_null": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "unique_strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty_string"}
    },
    "policy_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_evidence",
        "calculation_effect",
        "decision_authority",
        "decision_status",
        "examples",
        "plain_language",
        "recommended_treatment",
        "selected_treatment"
      ],
      "properties": {
        "approval_evidence": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "calculation_effect": {"$ref": "#/$defs/nonempty_string"},
        "decision_authority": {
          "enum": [
            "FINANCIAL_MVP_DEFINITION",
            "OWNER_318",
            "PORT_PERF_1",
            "SHARED_FLOW_POLICY_324"
          ]
        },
        "decision_status": {
          "enum": [
            "SETTLED_BY_PRODUCT_DEFINITION",
            "SETTLED_BY_EXISTING_POLICY",
            "OWNER_DECISION_REQUIRED",
            "DEPENDENCY_REQUIRED",
            "APPROVED"
          ]
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty_string"}
        },
        "plain_language": {"$ref": "#/$defs/nonempty_string"},
        "recommended_treatment": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "selected_treatment": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "owner_decision_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_on",
        "authority_issue",
        "comment_id",
        "decision_id",
        "digest_comment_id",
        "digest_evidence_url",
        "evidence_url",
        "payload_sha256",
        "policy_owner_issue"
      ],
      "properties": {
        "approved_on": {
          "type": "string",
          "format": "date"
        },
        "authority_issue": {"const": 330},
        "comment_id": {"type": "integer", "minimum": 1},
        "decision_id": {"$ref": "#/$defs/nonempty_string"},
        "digest_comment_id": {"type": "integer", "minimum": 1},
        "digest_evidence_url": {"$ref": "#/$defs/nonempty_string"},
        "evidence_url": {"$ref": "#/$defs/nonempty_string"},
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_owner_issue": {"const": 318}
      }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "readiness": {
      "enum": ["READY", "REQUIRED_NOT_READY"]
    },
    "requirement": {
      "enum": ["REQUIRED", "OPTIONAL", "EXCLUDED"]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of_policy",
        "final_artifacts",
        "operator_outcome",
        "product_id",
        "product_version",
        "publication_boundary",
        "repository_compatibility",
        "runtime_profile"
      ],
      "properties": {
        "product_id": {"const": "FINANCIAL_MVP"},
        "product_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        },
        "runtime_profile": {"const": "PORTFOLIO_SOURCE_TO_PANEL_V1"},
        "operator_outcome": {"$ref": "#/$defs/nonempty_string"},
        "as_of_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["calendar_cutoff", "policy_id", "publication_lag_rule"],
          "properties": {
            "calendar_cutoff": {"$ref": "#/$defs/nonempty_string"},
            "policy_id": {"$ref": "#/$defs/nonempty_string"},
            "publication_lag_rule": {"$ref": "#/$defs/nonempty_string"}
          }
        },
        "repository_compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum_main_sha",
            "pipeline_profile",
            "vertical_recipe_schema_versions"
          ],
          "properties": {
            "minimum_main_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "pipeline_profile": {"const": "PORTFOLIO_SOURCE_TO_PANEL_V1"},
            "vertical_recipe_schema_versions": {
              "const": [6, 7]
            }
          }
        },
        "final_artifacts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["acceptance", "role"],
            "properties": {
              "acceptance": {"$ref": "#/$defs/nonempty_string"},
              "role": {
                "enum": ["REPORT", "WORKBOOK", "PANEL", "RELEASE_RECEIPT"]
              }
            }
          }
        },
        "publication_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "required_issue_sequence", "status"],
          "properties": {
            "authority": {"const": "SEPARATE_EXPLICIT_RELEASE_AUTHORIZATION"},
            "required_issue_sequence": {"const": [332, 283]},
            "status": {"const": "NOT_AUTHORIZED_BY_THIS_CONTRACT"}
          }
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockers",
        "effective_product_interval",
        "funded_membership",
        "history_series_id",
        "outcome_dispositions",
        "product_requirement",
        "readiness",
        "readiness_reason",
        "strategy_id",
        "strategy_version"
      ],
      "properties": {
        "strategy_id": {"$ref": "#/$defs/nonempty_string"},
        "history_series_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "product_requirement": {"$ref": "#/$defs/requirement"},
        "readiness": {"$ref": "#/$defs/readiness"},
        "readiness_reason": {"$ref": "#/$defs/nonempty_string"},
        "blockers": {"$ref": "#/$defs/blockers"},
        "effective_product_interval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effective_end", "effective_start"],
          "properties": {
            "effective_start": {"type": "string", "format": "date"},
            "effective_end": {"$ref": "#/$defs/date_or_null"}
          }
        },
        "strategy_version": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "version_ref"],
          "properties": {
            "status": {"enum": ["EVIDENCED", "UNRESOLVED"]},
            "version_ref": {"type": ["string", "null"], "minLength": 1}
          }
        },
        "funded_membership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "effective_end", "effective_start", "status"],
          "properties": {
            "authority": {"$ref": "#/$defs/nonempty_string"},
            "effective_start": {"$ref": "#/$defs/date_or_null"},
            "effective_end": {"$ref": "#/$defs/date_or_null"},
            "status": {
              "enum": ["EVIDENCED", "REQUIRED_NOT_READY", "EXCLUDED"]
            }
          }
        },
        "outcome_dispositions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "AS_HELD_COMPOSITE_HWM",
            "DECOMPOSITION",
            "DEPENDENCE",
            "INVESTED_CAPITAL"
          ],
          "properties": {
            "AS_HELD_COMPOSITE_HWM": {
              "enum": ["REQUIRED", "EXCLUDED_BY_ACCEPTED_POLICY"]
            },
            "DECOMPOSITION": {
              "enum": ["REQUIRED", "EXCLUDED_BY_ACCEPTED_POLICY"]
            },
            "DEPENDENCE": {
              "enum": ["REQUIRED", "EXCLUDED_BY_ACCEPTED_POLICY"]
            },
            "INVESTED_CAPITAL": {
              "enum": ["REQUIRED", "EXCLUDED_BY_ACCEPTED_POLICY"]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"readiness": {"const": "REQUIRED_NOT_READY"}},
            "required": ["readiness"]
          },
          "then": {
            "properties": {"blockers": {"minItems": 1}}
          }
        }
      ]
    },
    "history_corrections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corrections",
        "materialized_segment_identities",
        "owner_issue",
        "policy_id",
        "policy_version",
        "splice_policy"
      ],
      "properties": {
        "policy_id": {"const": "PORT-HISTORY-TRUTH-1"},
        "policy_version": {"const": 1},
        "owner_issue": {"const": 319},
        "splice_policy": {
          "const": "SELECT_ONE_ACCEPTED_LIVE_LAYER; BACKTEST_ONLY_WHEN_EXACT_VERSION_MATCHED_AND_STRICTLY_BEFORE_LIVE_INCEPTION; NEVER_RELABEL_PROVIDER_EVIDENCE_AS_ACCOUNT_LIVE"
        },
        "corrections": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/history_correction"}
        },
        "materialized_segment_identities": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/materialized_segment_identity"}
        }
      }
    },
    "materialized_segment_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar",
        "canonicalization",
        "evidence_layer",
        "frequency",
        "mode_admission",
        "observed_end",
        "observed_start",
        "return_basis",
        "return_observations",
        "return_type",
        "segment_id",
        "sha256",
        "source_generation_id",
        "source_generation_sha256",
        "source_id",
        "strategy_id",
        "strategy_version"
      ],
      "properties": {
        "calendar": {"$ref": "#/$defs/nonempty_string"},
        "canonicalization": {"const": "CORRELATION_FIELDS_V2_CANONICAL_CSV_V1"},
        "evidence_layer": {
          "enum": ["ACCOUNT_LIVE", "BACKTEST", "PROVIDER_LIVE"]
        },
        "frequency": {"$ref": "#/$defs/nonempty_string"},
        "mode_admission": {
          "enum": [
            "EXCLUDE_COMPARISON_ONLY",
            "INCLUDE_SELECTED_LIVE",
            "INCLUDE_VERSION_COMPATIBLE_PREHISTORY",
            "REQUIRED_NOT_READY_OVERLAP"
          ]
        },
        "observed_end": {"type": "string", "format": "date"},
        "observed_start": {"type": "string", "format": "date"},
        "return_basis": {"$ref": "#/$defs/nonempty_string"},
        "return_observations": {"type": "integer", "minimum": 1},
        "return_type": {"$ref": "#/$defs/nonempty_string"},
        "segment_id": {"$ref": "#/$defs/nonempty_string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_generation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_id": {"$ref": "#/$defs/nonempty_string"},
        "strategy_id": {"$ref": "#/$defs/nonempty_string"},
        "strategy_version": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "history_correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockers",
        "capture",
        "correction_id",
        "disposition_reason",
        "evidence_layer",
        "funding_event",
        "history_existence",
        "interval",
        "mode_admission",
        "readiness",
        "source_id",
        "source_receipts",
        "strategy_id",
        "strategy_version"
      ],
      "properties": {
        "correction_id": {"$ref": "#/$defs/nonempty_string"},
        "strategy_id": {"$ref": "#/$defs/nonempty_string"},
        "source_id": {"$ref": "#/$defs/nonempty_string"},
        "evidence_layer": {
          "enum": [
            "ACCOUNT_LIVE",
            "BACKTEST",
            "PROVIDER_LIVE",
            "PROVIDER_TRACK_RECORD"
          ]
        },
        "history_existence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "status"],
          "properties": {
            "authority": {"$ref": "#/$defs/nonempty_string"},
            "status": {"enum": ["EXISTS", "DOES_NOT_EXIST", "UNRESOLVED"]}
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "as_of",
            "capture_defect",
            "generation_id",
            "generation_sha256",
            "status"
          ],
          "properties": {
            "status": {"enum": ["CAPTURED_GOVERNED", "NOT_CAPTURED", "UNRESOLVED"]},
            "capture_defect": {"type": ["string", "null"], "minLength": 1},
            "generation_id": {"$ref": "#/$defs/hash_or_null"},
            "generation_sha256": {"$ref": "#/$defs/hash_or_null"},
            "as_of": {"$ref": "#/$defs/date_or_null"}
          }
        },
        "strategy_version": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "compatibility", "status", "version_ref"],
          "properties": {
            "status": {"enum": ["EVIDENCED", "NOT_APPLICABLE", "UNRESOLVED"]},
            "version_ref": {"type": ["string", "null"], "minLength": 1},
            "compatibility": {"enum": ["ACCOUNT_OWNED", "EXACT_MATCH", "NOT_APPLICABLE", "UNRESOLVED"]},
            "authority": {"$ref": "#/$defs/nonempty_string"}
          }
        },
        "interval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assignment_date",
            "effective_end",
            "effective_start",
            "observed_end",
            "observed_start"
          ],
          "properties": {
            "assignment_date": {"$ref": "#/$defs/date_or_null"},
            "effective_start": {"$ref": "#/$defs/date_or_null"},
            "effective_end": {"$ref": "#/$defs/date_or_null"},
            "observed_start": {"$ref": "#/$defs/date_or_null"},
            "observed_end": {"$ref": "#/$defs/date_or_null"}
          }
        },
        "funding_event": {
          "type": "object",
          "additionalProperties": false,
          "required": ["account_live_start", "authority", "event_date", "status"],
          "properties": {
            "status": {"enum": ["EVIDENCED", "NOT_APPLICABLE", "UNRESOLVED"]},
            "event_date": {"$ref": "#/$defs/date_or_null"},
            "account_live_start": {"$ref": "#/$defs/date_or_null"},
            "authority": {"$ref": "#/$defs/nonempty_string"}
          }
        },
        "mode_admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["LIVE_ONLY", "LIVE_PLUS_BACKTEST"],
          "properties": {
            "LIVE_ONLY": {
              "enum": ["EXCLUDE_COMPARISON_ONLY", "EXCLUDE_EVENT_ONLY_RECONSTRUCTION", "INCLUDE_SELECTED_LIVE", "NOT_APPLICABLE", "REQUIRED_NOT_READY"]
            },
            "LIVE_PLUS_BACKTEST": {
              "enum": ["EXCLUDE_COMPARISON_ONLY", "EXCLUDE_EVENT_ONLY_RECONSTRUCTION", "INCLUDE_EXACT_VERSION_BACKTEST_PREHISTORY", "INCLUDE_SELECTED_LIVE", "NOT_APPLICABLE", "REQUIRED_NOT_READY"]
            }
          }
        },
        "source_receipts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_role",
              "artifact_selector",
              "authority_root",
              "generation_id",
              "locator_kind",
              "manifest_artifact_id",
              "sha256"
            ],
            "properties": {
              "artifact_role": {"$ref": "#/$defs/nonempty_string"},
              "artifact_selector": {"$ref": "#/$defs/nonempty_string"},
              "authority_root": {
                "enum": ["MATRIXPORT", "PORTFOLIO123", "PROVIDER_LEDGER", "QUANTBASE"]
              },
              "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "locator_kind": {
                "enum": ["CURRENT_POINTER", "GENERATION_ARTIFACT", "GENERATION_MANIFEST"]
              },
              "manifest_artifact_id": {"type": ["string", "null"], "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "allOf": [
              {
                "if": {"properties": {"locator_kind": {"const": "GENERATION_ARTIFACT"}}},
                "then": {"properties": {"manifest_artifact_id": {"type": "string", "minLength": 1}}},
                "else": {"properties": {"manifest_artifact_id": {"type": "null"}}}
              }
            ]
          }
        },
        "rejected_evidence_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalization",
            "return_observations",
            "sha256",
            "source_receipt_sha256"
          ],
          "properties": {
            "canonicalization": {"const": "TARGET_FIELDS_CANONICAL_JSON_V1"},
            "return_observations": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "source_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "derived_evidence_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "calendar",
            "cash_added_treatment",
            "equity_overlap_observations",
            "observed_end",
            "observed_start",
            "raw_level_observations",
            "return_observations",
            "transform_id"
          ],
          "properties": {
            "calendar": {"$ref": "#/$defs/nonempty_string"},
            "cash_added_treatment": {"$ref": "#/$defs/nonempty_string"},
            "equity_overlap_observations": {"type": "integer", "minimum": 2},
            "observed_end": {"type": "string", "format": "date"},
            "observed_start": {"type": "string", "format": "date"},
            "raw_level_observations": {"type": "integer", "minimum": 2},
            "return_observations": {"type": "integer", "minimum": 1},
            "transform_id": {"$ref": "#/$defs/nonempty_string"}
          }
        },
        "derived_backtest_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index_observations",
            "observed_end",
            "observed_start",
            "relationship_type",
            "return_observations",
            "source_labels"
          ],
          "properties": {
            "index_observations": {"type": "integer", "minimum": 2},
            "observed_end": {"type": "string", "format": "date"},
            "observed_start": {"type": "string", "format": "date"},
            "relationship_type": {"$ref": "#/$defs/nonempty_string"},
            "return_observations": {"type": "integer", "minimum": 1},
            "source_labels": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/nonempty_string"}
            }
          }
        },
        "disposition_reason": {"$ref": "#/$defs/nonempty_string"},
        "readiness": {"$ref": "#/$defs/readiness"},
        "blockers": {"$ref": "#/$defs/blockers"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_statuses",
        "blockers",
        "calculation_contract",
        "consumers",
        "outcome_id",
        "owner_issue",
        "product_requirement",
        "readiness"
      ],
      "properties": {
        "outcome_id": {
          "enum": [
            "AS_HELD_COMPOSITE_HWM",
            "INVESTED_CAPITAL",
            "DECOMPOSITION",
            "DEPENDENCE"
          ]
        },
        "owner_issue": {"type": "integer", "minimum": 1},
        "product_requirement": {"const": "REQUIRED"},
        "readiness": {"$ref": "#/$defs/readiness"},
        "blockers": {"$ref": "#/$defs/blockers"},
        "accepted_statuses": {"$ref": "#/$defs/unique_strings"},
        "consumers": {"$ref": "#/$defs/unique_strings"},
        "calculation_contract": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "alignment": {"$ref": "#/$defs/nonempty_string"},
            "analyses": {"$ref": "#/$defs/unique_strings"},
            "capital": {"$ref": "#/$defs/nonempty_string"},
            "change_control": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "authoritative_edit_location",
                "check_command",
                "decision_digest_command",
                "downstream_issues",
                "edit_rule",
                "generated_views",
                "identity_rule",
                "live_evidence_command",
                "propagation_command"
              ],
              "properties": {
                "authoritative_edit_location": {"$ref": "#/$defs/nonempty_string"},
                "check_command": {"$ref": "#/$defs/nonempty_string"},
                "decision_digest_command": {"$ref": "#/$defs/nonempty_string"},
                "downstream_issues": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "integer", "minimum": 1}
                },
                "edit_rule": {"$ref": "#/$defs/nonempty_string"},
                "generated_views": {"$ref": "#/$defs/unique_strings"},
                "identity_rule": {"$ref": "#/$defs/nonempty_string"},
                "live_evidence_command": {"$ref": "#/$defs/nonempty_string"},
                "propagation_command": {"$ref": "#/$defs/nonempty_string"}
              }
            },
            "classification_treatments": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "CORRECTION_REVERSAL",
                "DIVIDEND_INTEREST_REINVESTMENT",
                "EXTERNAL_CONTRIBUTION",
                "EXTERNAL_WITHDRAWAL",
                "FEE_TAX_REBATE_EXPENSE",
                "IN_KIND_FUNDING",
                "INTERNAL_TRANSFER",
                "MARGIN_FINANCING",
                "OPENING_CONTRIBUTED_BASIS",
                "PREDECESSOR_TRANSITION"
              ],
              "properties": {
                "CORRECTION_REVERSAL": {"$ref": "#/$defs/policy_decision"},
