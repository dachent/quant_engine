{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dachent/quant_engine/schemas/portfolio/account-flow-coverage.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "as_of_date", "ledger_identity", "classified_flows_artifact", "mapped_assignments_identity", "receipt_artifacts", "rows"],
  "properties": {
    "schema_version": {"const": 2}, "artifact_id": {"type": "string", "minLength": 1}, "as_of_date": {"$ref": "#/$defs/date"}, "ledger_identity": {"$ref": "#/$defs/ledger_identity"}, "classified_flows_artifact": {"$ref": "#/$defs/artifact"}, "mapped_assignments_identity": {"type": "object", "additionalProperties": false, "required": ["sha256", "count"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "count": {"type": "integer", "minimum": 0}}}, "receipt_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "sha256", "size_bytes"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}}}, "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "as_of_date", "schema", "sha256", "size_bytes"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "as_of_date": {"$ref": "#/$defs/date"}, "schema": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "derivation": {"type": "object", "additionalProperties": false, "required": ["parent_account_id", "sleeve_facts_sha256"], "properties": {"parent_account_id": {"type": "string", "minLength": 1}, "sleeve_facts_sha256": {"$ref": "#/$defs/sha256"}}},
    "ledger_identity": {"type": "object", "additionalProperties": false, "required": ["generation_id", "artifact"], "properties": {"generation_id": {"$ref": "#/$defs/sha256"}, "artifact": {"$ref": "#/$defs/artifact"}}},
    "assignment": {"type": "object", "additionalProperties": false, "required": ["account_id", "strategy_id", "effective_start", "effective_end"], "properties": {"account_id": {"type": "string", "minLength": 1}, "strategy_id": {"type": "string", "minLength": 1}, "effective_start": {"$ref": "#/$defs/date"}, "effective_end": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}}},
    "row": {"type": "object", "additionalProperties": false, "required": ["assignment", "requested_start", "requested_end", "status", "authority_kind", "receipt_artifact_id", "blocker_code", "blocker_detail"], "properties": {"assignment": {"$ref": "#/$defs/assignment"}, "requested_start": {"$ref": "#/$defs/date"}, "requested_end": {"$ref": "#/$defs/date"}, "status": {"enum": ["COMPLETE", "BLOCKED"]}, "authority_kind": {"enum": ["ACCOUNT_INTERVAL_RETRIEVAL_RECEIPT_V2", "STATIC_SNAPSHOT_COVERAGE_V1", "DERIVED_SLEEVE_COVERAGE_V1", "NONE"]}, "derivation": {"$ref": "#/$defs/derivation"}, "receipt_artifact_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "blocker_code": {"anyOf": [{"enum": ["NO_ADMISSIBLE_V2_RECEIPT", "ACCOUNT_BINDING_MISMATCH", "INTERVAL_BOUNDARY_MISMATCH", "CATEGORY_SET_INCOMPLETE", "PAGINATION_NOT_TERMINAL", "SOURCE_IDENTITY_MISMATCH", "RECEIPT_OVERLAP", "RECEIPT_GAP", "LEGACY_RECEIPT_UNVERIFIABLE"]}, {"type": "null"}]}, "blocker_detail": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"status": {"const": "COMPLETE"}}}, "then": {"properties": {"authority_kind": {"enum": ["ACCOUNT_INTERVAL_RETRIEVAL_RECEIPT_V2", "STATIC_SNAPSHOT_COVERAGE_V1", "DERIVED_SLEEVE_COVERAGE_V1"]}, "receipt_artifact_id": {"type": "string", "minLength": 1}, "blocker_code": {"type": "null"}, "blocker_detail": {"type": "null"}}}}, {"if": {"properties": {"authority_kind": {"const": "DERIVED_SLEEVE_COVERAGE_V1"}}, "required": ["authority_kind"]}, "then": {"required": ["derivation"]}, "else": {"not": {"required": ["derivation"]}}}, {"if": {"properties": {"status": {"const": "BLOCKED"}}}, "then": {"properties": {"authority_kind": {"const": "NONE"}, "receipt_artifact_id": {"type": "null"}, "blocker_code": {"type": "string", "minLength": 1}, "blocker_detail": {"type": "string", "minLength": 1}}}}]}
  }
}
