{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {"const": "account-strategy-current-epoch-crosswalk"},
    "as_of_date": {"format": "date", "type": "string"},
    "calculation_cutoff_date": {"format": "date", "type": "string"},
    "disposition_counts": {"additionalProperties": false, "properties": {"EXCLUDED_DEPRECATED_HISTORY_ONLY":{"const":1},"EXCLUDED_IMMATERIAL":{"const":1},"INCLUDED_PRODUCT_EPOCH":{"const":13}},"required":["INCLUDED_PRODUCT_EPOCH","EXCLUDED_DEPRECATED_HISTORY_ONLY","EXCLUDED_IMMATERIAL"],"type":"object"},
    "rows": {"items": {"$ref": "#/$defs/row"}, "maxItems": 15, "minItems": 15, "type": "array"},
    "schema_version": {"const": 1},
    "selected_baseline": {"$ref": "#/$defs/baseline"}
  },
  "required": ["schema_version", "artifact_id", "as_of_date", "calculation_cutoff_date", "disposition_counts", "selected_baseline", "rows"],
  "allOf": [
    {"properties":{"rows":{"contains":{"properties":{"product_epoch_disposition":{"const":"INCLUDED_PRODUCT_EPOCH"},"effective_end":{"type":"null"}},"required":["product_epoch_disposition","effective_end"]},"minContains":11,"maxContains":11}}},
    {"properties":{"rows":{"contains":{"properties":{"product_epoch_disposition":{"const":"INCLUDED_PRODUCT_EPOCH"},"effective_end":{"type":"string"}},"required":["product_epoch_disposition","effective_end"]},"minContains":2,"maxContains":2}}},
    {"properties":{"rows":{"contains":{"properties":{"product_epoch_disposition":{"const":"EXCLUDED_DEPRECATED_HISTORY_ONLY"}},"required":["product_epoch_disposition"]},"minContains":1,"maxContains":1}}},
    {"properties":{"rows":{"contains":{"properties":{"product_epoch_disposition":{"const":"EXCLUDED_IMMATERIAL"}},"required":["product_epoch_disposition"]},"minContains":1,"maxContains":1}}}
  ],
  "type": "object",
  "$defs": {
    "baseline": {"additionalProperties": false, "properties": {"artifact_id":{"const":"normalized/portfolio-baseline.json"},"as_of_date":{"format":"date","type":"string"},"generation_id":{"pattern":"^[0-9a-f]{64}$","type":"string"},"schema_name":{"const":"portfolio-baseline-catalog"},"schema_version":{"enum":["1","2"]},"sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"size_bytes":{"minimum":1,"type":"integer"}},"required":["generation_id","artifact_id","sha256","size_bytes","as_of_date","schema_name","schema_version"],"type":"object"},
    "row": {"additionalProperties": false,"properties":{"account_id":{"pattern":"^[a-z][a-z0-9-]{0,63}$","type":"string"},"account_label":{"minLength":1,"type":"string"},"assignment_id":{"pattern":"^[a-z][a-z0-9-]{0,63}$","type":"string"},"effective_end":{"format":"date","type":["string","null"]},"effective_start":{"format":"date","type":"string"},"last_four":{"pattern":"^[0-9]{4}$","type":["string","null"]},"owner_reason":{"pattern":"^[A-Z][A-Z0-9_]*$","type":"string"},"product_epoch_disposition":{"enum":["INCLUDED_PRODUCT_EPOCH","EXCLUDED_DEPRECATED_HISTORY_ONLY","EXCLUDED_IMMATERIAL"]},"provider":{"minLength":1,"type":"string"},"strategy_id":{"pattern":"^[a-z][a-z0-9-]{0,63}$","type":"string"}},"required":["assignment_id","account_id","provider","strategy_id","effective_start","effective_end","account_label","last_four","product_epoch_disposition","owner_reason"],"type":"object"}
  }
}
