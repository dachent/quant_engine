{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dachent/quant_engine/schemas/portfolio/report-data.schema.json",
  "title": "Private coverage-aware portfolio report data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_schema_version",
    "as_of_date",
    "baseline",
    "portfolio_summary",
    "account_summary",
    "strategy_summary",
    "positions",
    "provider_admissions",
    "provider_coverage",
    "provider_strategy_returns",
    "strategy_provider_evidence",
    "strategy_returns",
    "transactions_and_flows",
    "twr_mwr",
    "allocation_history",
    "flow_reconciliation",
    "reconciliation_checks",
    "coverage_data_quality",
    "corrections",
    "methodology",
    "provenance"
  ],
  "properties": {
    "report_schema_version": {"const": 1},
    "as_of_date": {"type": "string", "format": "date"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_id", "catalog_sha256"],
      "properties": {
        "generation_id": {"$ref": "#/$defs/sha256"},
        "catalog_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "portfolio_summary": {"type": "array", "minItems": 8, "items": {"type": "object"}},
    "account_summary": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "strategy_summary": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "object"}},
    "provider_admissions": {"type": "array", "items": {"type": "object"}},
    "provider_coverage": {"type": "array", "items": {"type": "object"}},
    "provider_strategy_returns": {"type": "array", "items": {"type": "object"}},
    "strategy_provider_evidence": {"type": "array", "items": {"type": "object"}},
    "strategy_returns": {"type": "array", "items": {"type": "object"}},
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "enum": [
              "UNAVAILABLE_NO_ACCEPTED_POSITION_SOURCE",
              "AVAILABLE_UNMAPPED",
              "AVAILABLE_MAPPED"
            ]
          }
        }
      }
    },
    "transactions_and_flows": {"type": "array", "items": {"type": "object"}},
    "twr_mwr": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/performance"}},
    "allocation_history": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object"}},
    "flow_reconciliation": {"type": "array", "items": {"type": "object"}},
    "reconciliation_checks": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "coverage_data_quality": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "fact_coverage_matrix": {"type": "array", "items": {"type": "object"}},
    "hwm_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered_value_usd", "excluded_details", "excluded_strategies", "excluded_value_usd", "governed_perimeter_value_usd", "nav_coverage", "policy_id", "status", "status_code_version", "status_semantics", "uncovered_details", "uncovered_strategies", "uncovered_value_usd"],
      "properties": {
        "covered_value_usd": {"$ref": "#/$defs/decimal"},
        "excluded_details": {"type": "array", "items": {"type": "object"}},
        "excluded_strategies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "excluded_value_usd": {"$ref": "#/$defs/decimal"},
        "governed_perimeter_value_usd": {"$ref": "#/$defs/decimal"},
        "nav_coverage": {"$ref": "#/$defs/decimal"},
        "policy_id": {"const": "PORT-HWM-3"},
        "status": {"type": "string"},
        "status_code_version": {"const": 2},
        "status_semantics": {"const": "EXPLICIT_GOVERNED_HWM_PERIMETER"},
        "uncovered_details": {"type": "array", "items": {"type": "object"}},
        "uncovered_strategies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "uncovered_value_usd": {"$ref": "#/$defs/decimal"},
        "hwm_index": {"$ref": "#/$defs/decimal"},
        "hwm_current_drawdown": {"$ref": "#/$defs/decimal"},
        "hwm_maximum_drawdown": {"$ref": "#/$defs/decimal"},
        "hwm_numerical_status": {"type": "string", "enum": ["AVAILABLE", "UNAVAILABLE"]},
        "hwm_numerical_reason": {"type": "string"}
      }
    },
    "corrections": {"type": "array", "items": {"type": "object"}},
    "methodology": {"type": "array", "minItems": 7, "items": {"type": "object"}},
    "observation_windows": {"type": "array", "items": {"type": "object"}},
    "attribution_dispositions": {"type": "array", "items": {"type": "object"}},
    "strategy_attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_assignments", "comparisons", "costs", "generation_id"],
      "properties": {
        "benchmark_assignments": {"type": "array", "minItems": 9, "maxItems": 9},
        "comparisons": {"type": "array", "minItems": 9, "maxItems": 9},
        "costs": {"type": "array", "minItems": 9, "maxItems": 9},
        "generation_id": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {"type": "array", "minItems": 2, "items": {"type": "object"}}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "performance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "account_id",
        "assignment_id",
        "strategy_id",
        "twr",
        "twr_status",
        "mwr_xirr",
        "mwr_status",
        "flow_timing"
      ],
      "properties": {
        "account_id": {"type": "string", "minLength": 1},
        "assignment_id": {"type": "string", "minLength": 1},
        "strategy_id": {"type": ["string", "null"]},
        "twr": {"type": ["string", "null"]},
        "twr_status": {
          "enum": [
            "AVAILABLE_WITH_INFERRED_FLOW_TIMING",
            "UNAVAILABLE",
            "UNMAPPED",
            "UNAVAILABLE_INSUFFICIENT_NAV",
            "UNAVAILABLE_MISSING_NAV",
            "UNAVAILABLE_FLOW_WITHOUT_SAME_DATE_NAV",
            "UNAVAILABLE_FLOW_AMOUNT",
            "UNAVAILABLE_NONPOSITIVE_PRIOR_NAV"
          ]
        },
        "mwr_xirr": {"type": "null"},
        "mwr_status": {"const": "UNAVAILABLE_INCOMPLETE_FLOW_COVERAGE"},
        "flow_timing": {"const": "DATE_ONLY_END_OF_DAY_INFERRED_TIMING"}
      }
    }
  }
}
