{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dachent/quant_engine/schemas/providers/turingtrader-performance-chart.schema.json",
  "title": "TuringTrader performance-chart.json payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["series"],
  "properties": {
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "nav"],
        "properties": {
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "nav": {"type": "number"}
        }
      }
    }
  }
}
